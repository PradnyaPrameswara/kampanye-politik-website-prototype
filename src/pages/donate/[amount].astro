---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';
import { DonateButton } from '../../components/react/DonateButton';

export async function getStaticPaths() {
  const donations = await getCollection('donations');

  return donations.map(entry => ({
    params: { amount: entry.data.amount.toString() },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const allDonations = await getCollection('donations');

const relatedDonations = allDonations.filter(d => d.data.amount !== entry.data.amount);
---

<ContentLayout 
  title={`CivicUnity - Donate $${entry.data.amount} | Empowering Our Nation`}
  bannerTitle="Donate details"
  bannerImage="/images/assets/66dc04dad61c93d48ea99d92_Donate%20Bg%20Image.webp"
  currentPath="/donate"
>
  <div class="donation-details">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-large is-header">
          <div class="donation-details-component">
            <div class="donation-details-left-content-wrapper">
              <div class="donation-details-left-top-content">
                <h2 class="heading-style-h2">{entry.data.title}</h2>
                <p class="text-size-regular">{entry.data.description}</p>
              </div>
              <div class="padding-bottom padding-medium"></div>
              <h3 class="heading-style-h3">${entry.data.amount}</h3>
              <div class="padding-bottom padding-medium"></div>
              <div class="donation-collection-list-wrapper w-dyn-list">
                <div class="donation-collection-list w-dyn-items" role="list">
                  {[100, 50, 25, 10, 5].map((amount) => (
                    <div class="donation-collection-list-item w-dyn-item" role="listitem">
                      <a href={`/donate/${amount}`} class={`donation-card w-inline-block ${amount === entry.data.amount ? 'w--current' : ''}`}>
                        <h6 class="heading-style-h6 is-white">${amount}</h6>
                      </a>
                    </div>
                  ))}
                </div>
              </div>
              <div class="padding-bottom padding-medium"></div>
              <DonateButton 
                client:visible
                stripePriceId={entry.data.stripePriceId}
                amount={entry.data.amount}
              />
            </div>
            <div class="donation-details-image-wrapper">
              <img 
                src="/images/assets/66dc04da185f32d46eb9e04a_Donation%20Image.webp" 
                loading="lazy" 
                sizes="(max-width: 479px) 93vw, (max-width: 991px) 94vw, 532px" 
                alt="Donation" 
                class="donation-details-image" 
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>
