---
import ContentLayout from '../../layouts/ContentLayout.astro';
---

<ContentLayout title="Donation Cancelled">
  <div class="min-h-[60vh] flex items-center justify-center bg-neutral-white-200 py-16">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <div class="bg-neutral-white p-12 rounded-[0.75rem] shadow-subtle">
        <div class="w-16 h-16 bg-red-100 text-brand-red rounded-full flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold font-lora text-neutral-black-900 mb-4">Donation Cancelled</h1>
        <p class="text-lg text-neutral-black-600 mb-8">Your donation process was cancelled and no charges were made.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/#donate" class="inline-block px-8 py-[0.8125rem] bg-brand-blue text-neutral-white font-medium rounded-[0.75rem] hover:bg-brand-red transition-colors">Try Again</a>
          <a href="/" class="inline-block px-8 py-[0.8125rem] bg-neutral-white-300 text-neutral-black-700 font-medium rounded-[0.75rem] hover:bg-neutral-white-200 transition-colors">Return to Home</a>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>
