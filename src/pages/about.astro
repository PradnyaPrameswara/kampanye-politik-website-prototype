---
import ContentLayout from '@/layouts/ContentLayout.astro';
import FaqAccordion from '@/components/react/FaqAccordion';
import ValuesInteractive from '@/components/react/ValuesInteractive';
import MissionVisionCards from '@/components/react/MissionVisionCards';
import { getCollection } from 'astro:content';
import { faqItems, faqTitle, faqSubtitle } from '@/components/sections/faq';

const allPosts = await getCollection('blog');

const blogPosts = allPosts.slice(0, 2);

const blogImages = {
  'understanding-recent-policy-changes': '/images/assets/66de845af00d0586abb5ff9f_Blog%20Image%206.jpg',
  'building-strong-advocacy-coalitions': '/images/assets/66de844253d3899d0b7ea2ae_Blog%20Image%205.jpg',
  'community-initiatives-making-a-difference': '/images/assets/66de84243555ab75c62dcfa4_Blog%20Image%204.jpg',
  'impact-of-policy-on-local-communities': '/images/assets/66de840153d3899d0b7e7164_Blog%20Image%203.jpg',
  'effective-advocacy-strategies-for-success': '/images/assets/66de83db9b602e1b2f5a8425_Blog%20Image%202.jpg',
  'stories-of-community-impact-and-change': '/images/assets/66de82a68945e61eaf28d812_Blog%20Image%201.jpg',
} as const;

const teamMembers = [
  {
    name: 'Presiden Prabowo Subianto',
    role: 'Presiden Republik Indonesia',
    slug: 'john-smith',
    image: '/images/assets/66de885235a491ec7c9579d4_Team%20Image%206.webp',
  },
  {
    name: 'Kementerian Komunikasi & Digital',
    role: 'Transformasi Digital & GovTech INA Digital',
    slug: 'sarah-johnson',
    image: '/images/assets/66de8849ae04b9432a83ed16_Team%20Image%205.webp',
  },
  {
    name: 'Badan Gizi Nasional',
    role: 'Program Makan Bergizi Gratis (MBG)',
    slug: 'michael-brown',
    image: '/images/assets/66de8840477d16d8930afdba_Team%20Image%204.webp',
  },
];
---

<ContentLayout 
  title="Kabinet Merah Putih — Tentang Asta Cita" 
  bannerTitle="Tentang Kabinet" 
  bannerImage="/images/assets/66dc04d833d0f035179dae54_About%20Hero%20Image.webp"
  currentPath="/about"
>
  <!-- Section About -->
  <div class="section-about">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium is-header">
          <div class="about-component is-about">
            <div class="about-top-content-wrapper reveal-down">
              <div class="about-top-left-content">
                <h2 class="heading-style-h2">Komitmen Kedaulatan Bangsa & Kemakmuran Rakyat.</h2>
                <p class="text-size-regular">Di bawah kepemimpinan Presiden Prabowo Subianto, Kabinet Merah Putih menggerakkan reformasi struktural terpadu demi swasembada pangan, energi, dan kemakmuran seluruh rakyat Indonesia.</p>
              </div>
              <div class="about-image-wrapper _2nd">
                <img alt="Kabinet Merah Putih mengawal program prioritas nasional" class="about-image" loading="lazy" sizes="(max-width: 991px) 100vw, 484px" src="/images/assets/66eb100ae5b4a9769e10e8d1_About%20Hero%20Image.jpg" />
              </div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="about-bottom-content-wrapper reveal-up">
              <div class="about-image-wrapper _3rd">
                <img alt="Sinergi kementerian dan lembaga dalam Kabinet Merah Putih" class="about-image" loading="lazy" sizes="(max-width: 991px) 100vw, 384px" src="/images/assets/66dc04da39706fc65e5ae289_About%20Hero%20Image%204.webp" />
              </div>
              <div class="about-image-wrapper _02">
                <img alt="Pemberdayaan masyarakat dan pembangunan daerah" class="about-image" loading="lazy" sizes="(max-width: 991px) 100vw, 384px" src="/images/assets/66dc04daf0ccb5209771b2c5_About%20Hero%20Image%203.webp" />
              </div>
              <div class="about-image-wrapper">
                <img alt="Kegiatan konsolidasi program strategis nasional" class="about-image" loading="lazy" sizes="(max-width: 479px) 93vw, (max-width: 991px) 94vw, 384px" src="/images/assets/66dc04db22177f0428b4ccdf_About%20Hero%20Image%202.webp" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Community Stats -->
  <div class="section-community">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="community-component reveal-scale">
            <div class="community-card">
              <h2 class="heading-style-h2">82,9 Jt+</h2>
              <div class="text-size-regular">Target Penerima Makan Bergizi</div>
            </div>
            <div class="community-card">
              <h2 class="heading-style-h2">3 Jt</h2>
              <div class="text-size-regular">Target Rumah</div>
            </div>
            <div class="community-card">
              <h2 class="heading-style-h2">100%</h2>
              <div class="text-size-regular">Ketahanan Energi</div>
            </div>
            <div class="community-card _2nd">
              <h2 class="heading-style-h2">26</h2>
              <div class="text-size-regular">Komoditas Strategis</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Mission -->
  <div class="section-mission">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="mission-component">
            <div class="mission-top-content-wrapper reveal-down">
              <div class="mission-top-left-content">
                <div class="headline"><div class="dot"></div><div>Misi dan Visi Kami</div></div>
                <h2 class="heading-style-h2">Misi dan Visi untuk Dampak yang Berkelanjutan.</h2>
              </div>
              <p class="text-size-regular">Misi nasional yang komprehensif untuk menjaga kedaulatan, menghapus kemiskinan, dan mewujudkan Indonesia Emas 2045.</p>
            </div>
            <MissionVisionCards client:visible />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Value -->
  <div class="section-value">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium is-value">
          <ValuesInteractive client:visible />
        </div>
      </div>
    </div>
  </div>

  <!-- Section Team -->
  <div class="section-team">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="team-component">
            <div class="team-top-content-wrapper reveal-down">
              <div class="team-top-left-content-wrapper">
                <div class="headline"><div class="dot"></div><div>Tim</div></div>
                <h2 class="heading-style-h2">Membangun Bangsa yang Lebih Kuat Bersama.</h2>
              </div>
              <div class="text-size-regular">Pimpinan publik yang berdedikasi mengoordinasikan kementerian dan masyarakat untuk memajukan kesejahteraan, keamanan, dan kemajuan bersama bangsa.</div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="team-collection-list-wrapper w-dyn-list reveal-up">
              <div class="team-collection-list w-dyn-items" role="list">
                {teamMembers.map((member) => (
                  <div class="team-collection-list-item w-dyn-item" role="listitem">
                    <a class="team-card w-inline-block" href={`/member/${member.slug}`}>
                      <div class="team-image-wrapper" style="background-image:url('/images/assets/66dc1336a0bd34b5411c0bb8_Team%20Bg%20Image.jpg')">
                        <img alt={member.name} class="team-image" loading="lazy" sizes="100vw" src={member.image} />
                      </div>
                      <div class="team-card-content-wrapper">
                        <div class="team-card-content">
                          <h5 class="heading-style-h5 text-color-white">{member.name}</h5>
                          <img alt="" loading="lazy" src="/images/assets/66dc04d922177f0428b4cc55_Team%20Arrow.svg" />
                        </div>
                        <div class="text-size-regular text-color-white">{member.role}</div>
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section CTA -->
  <div class="section-cta">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="cta-component reveal-scale">
            <div class="cta-content-wrapper">
              <h2 class="heading-style-h2">Ambil Bagian dalam Perubahan.</h2>
              <a class="button w-inline-block" href="/contact"><div>Hubungi Kami</div></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section FAQ -->
  <FaqAccordion client:visible items={faqItems} title={faqTitle} subtitle={faqSubtitle} />

  <!-- Section Blog -->
  <div class="section-blog">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium padding-bottom-large">
          <div class="blog-component">
            <div class="blog-left-content-wrapper reveal-left">
              <div class="blog-left-top-content-wrapper">
                <div class="headline _2nd"><div class="dot"></div><div>Berita & Kebijakan</div></div>
                <div class="blog-left-top-content">
                  <h2 class="heading-style-h2 text-color-white">Warta Terkini untuk Memahami Kebijakan Nasional.</h2>
                  <div class="text-size-regular text-color-white-200">Baca ringkasan terkini tentang program unggulan, pembangunan daerah, dan kemandirian ekonomi.</div>
                </div>
                <a class="button w-inline-block" href="/blog"><div>Lihat Lainnya</div></a>
              </div>
            </div>
            <div class="blog-right-content-wrapper reveal-right">
              <div class="blog-collection-list-wrapper w-dyn-list">
                <div class="blog-collection-list w-dyn-items" role="list">
                  {blogPosts.map((post) => (
                    <div class="blog-collection-item w-dyn-item" role="listitem">
                      <div class="blog-card reveal-scale">
                        <div class="blog-image-wrapper">
                          <img 
                            alt={post.data.title} 
                            class="blog-image" 
                            loading="lazy" 
                            sizes="100vw" 
                            src={blogImages[post.slug as keyof typeof blogImages] || post.data.image} 
                          />
                        </div>
                        <div class="blog-card-content-wrapper">
                          <div class="text-size-small">
                            {new Date(post.data.publishDate).toLocaleDateString('id-ID', { month: 'long', day: 'numeric', year: 'numeric' })}
                          </div>
                          <a class="blog-text-link w-inline-block" href={`/post/${post.slug}`}>
                            <h5 class="heading-style-h5">{post.data.title}</h5>
                          </a>
                          <div class="blog-card-content">
                            <a class="blog-button w-inline-block" href={`/post/${post.slug}`}>
                              <div>Baca Selengkapnya</div>
                              <img alt="" class="arrow" loading="lazy" src="/images/assets/66dc04d84a2c1e5e023ff6fd_Blog%20Arrow.svg" />
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>
