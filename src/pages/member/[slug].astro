---
import ContentLayout from '@/layouts/ContentLayout.astro';
import Banner from '@/components/sections/Banner.astro';
import SectionWrapper from '@/components/ui/SectionWrapper.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const team = await getCollection('team');

  return team.map(member => ({
    params: { slug: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
---

<ContentLayout title={`${member.data.name || member.id} | CivicUnity`}>
  <Banner title={member.data.name || member.id} />

  <SectionWrapper class="py-24" id="member-detail">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-16 items-start">
      <div class="reveal-left relative rounded-[0.75rem] overflow-hidden bg-neutral-white-200 aspect-[3/4]">
        <div class="absolute inset-0 z-0 bg-[url('/images/pattern-bg.svg')] bg-cover bg-center opacity-50"></div>
        <img 
          src={member.data.image ? (typeof member.data.image === 'string' ? member.data.image : member.data.image.src) : '/images/default-member.jpg'} 
          alt={member.data.name || member.id} 
          class="absolute bottom-0 left-1/2 -translate-x-1/2 h-[95%] w-auto object-cover object-bottom z-10" 
        />
      </div>
      
      <div class="reveal-right">
        <h2 class="text-4xl lg:text-5xl font-serif font-bold text-neutral-black-900 mb-2 leading-tight">
          {member.data.name || member.id}
        </h2>
        <p class="text-brand-blue text-xl font-medium mb-8">{member.data.title || 'Team Member'}</p>
        
        <div class="prose prose-lg text-neutral-black-600 max-w-none mb-10">
          <p class="leading-relaxed">{member.data.bio}</p>
        </div>
        
        {member.data.social && (
          <div class="flex gap-4">
            {member.data.social.twitter && (
              <a href={member.data.social.twitter} class="w-10 h-10 rounded-full bg-neutral-white-200 flex items-center justify-center text-neutral-black-700 hover:bg-brand-blue hover:text-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
              </a>
            )}
            {member.data.social.linkedin && (
              <a href={member.data.social.linkedin} class="w-10 h-10 rounded-full bg-neutral-white-200 flex items-center justify-center text-neutral-black-700 hover:bg-brand-blue hover:text-white transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </SectionWrapper>
</ContentLayout>
