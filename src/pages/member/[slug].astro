---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const team = await getCollection('team');

  return team.map(member => ({
    params: { slug: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;

const memberImages = {
  'john-smith': '/images/webflow/66de885235a491ec7c9579d4_Team%20Image%206.webp',
  'sarah-johnson': '/images/webflow/66de8849ae04b9432a83ed16_Team%20Image%205.webp',
  'michael-brown': '/images/webflow/66de8840477d16d8930afdba_Team%20Image%204.webp',
  'david-wilson': '/images/webflow/66de88373555ab75c632122c_Team%20Image%203.webp',
  'jessica-lee': '/images/webflow/66de882ef48421d2f55b6983_Team%20Image%202.webp',
  'james-clark': '/images/webflow/66de882483ff8257a260072a_Team%20Image%201.webp',
} as const;

type MemberSlug = keyof typeof memberImages;

interface LeaderRole {
  readonly title: string;
  readonly period: string;
}

interface LeaderProfile {
  readonly biography: string;
  readonly education: readonly string[];
  readonly roles: readonly LeaderRole[];
}

// SAFETY: member.id is confirmed to be an existing key in memberImages
const knownMemberImage = member.id in memberImages ? memberImages[member.id as MemberSlug] : undefined;

const memberImageSrc = knownMemberImage ?? (member.data.image ? member.data.image.src : `/images/team/${member.id}.webp`);

const leadershipProfiles: Record<MemberSlug, LeaderProfile> = {
  'john-smith': {
    biography: 'A career military commander, statesman, and entrepreneur, President Prabowo Subianto has devoted his life to safeguarding Indonesia\'s sovereignty and empowering farmers, fishermen, and workers. Under his presidency, the Asta Cita blueprint guides the nation toward strategic food and energy self-reliance, massive industrial downstreaming across 26 commodities, and universal child nutrition.',
    education: [
      'Indonesian Military Academy (AKABRI), Magelang — Graduated in 1974 with honors in Military Tactics and Leadership.',
      'Advanced Special Warfare & Command Courses at the US Army John F. Kennedy Special Warfare Center (Fort Bragg, USA) and US Army Infantry School (Fort Benning, USA).'
    ],
    roles: [
      { title: 'President of the Republic of Indonesia', period: 'October 2024 — Present' },
      { title: 'Minister of Defense of Indonesia', period: 'October 2019 — October 2024' },
      { title: 'General Chairman of Gerindra Party', period: 'September 2014 — Present' },
      { title: 'Commander of Army Strategic Command (Kostrad)', period: 'March 1998 — May 1998' },
      { title: 'Commander General of Kopassus Special Forces', period: 'December 1995 — March 1998' },
      { title: 'Chairman of Indonesian Farmers Association (HKTI)', period: 'December 2004 — August 2015' }
    ]
  },
  'sarah-johnson': {
    biography: 'Vice President Gibran Rakabuming Raka represents Indonesia\'s dynamic new generation of governance. Focusing on youth empowerment, digital public infrastructure, and creative economy development, he oversees the nationwide rollout of smart city services, GovTech INA Digital, and entrepreneurship incubators across all 38 provinces.',
    education: [
      'Management Development Institute of Singapore (MDIS) — Bachelor of Science in Marketing.',
      'University of Technology Sydney (UTS Insearch), Australia — Advanced Business Information Technology.'
    ],
    roles: [
      { title: 'Vice President of the Republic of Indonesia', period: 'October 2024 — Present' },
      { title: 'Mayor of Surakarta (Solo), Central Java', period: 'February 2021 — July 2024' },
      { title: 'Chairman of Solo Techno Park Advisory Board', period: 'March 2021 — July 2024' },
      { title: 'Chairman of Indonesian Creative Culinary Association', period: 'May 2018 — December 2020' },
      { title: 'National Youth Entrepreneurship Ambassador', period: 'January 2018 — January 2021' },
      { title: 'Digital MSME Modernization Pioneer', period: 'June 2015 — February 2021' }
    ]
  },
  'michael-brown': {
    biography: 'Prof. Dr. Dadan Hindayana leads the National Nutrition Agency (Badan Gizi Nasional - BGN). An esteemed entomologist and agricultural academic from IPB University, Prof. Dadan orchestrates the daily nationwide preparation and delivery of nutritious meals to 82.9 million schoolchildren, infants, and expectant mothers.',
    education: [
      'IPB University (Bogor Agricultural University) — Bachelor of Science in Plant Protection and Entomology.',
      'University of Bonn & Leibniz University Hannover, Germany — Master of Science and Doctorate in Agricultural Sciences (Dr. sc. agr.).'
    ],
    roles: [
      { title: 'Head of National Nutrition Agency (BGN)', period: 'August 2024 — Present' },
      { title: 'Professor of Entomology & Agroecology, IPB', period: 'June 2015 — Present' },
      { title: 'Director of Integrated Food Safety & Pest Control', period: 'March 2018 — August 2024' },
      { title: 'National Food Security Scientific Advisor', period: 'January 2020 — August 2024' },
      { title: 'Chair of Department of Plant Protection, IPB', period: 'April 2014 — May 2019' },
      { title: 'Senior Research Fellow in Sustainable Food Chains', period: 'September 2008 — March 2014' }
    ]
  },
  'david-wilson': {
    biography: 'Dr. Ir. Andi Amran Sulaiman, M.P. serves as Minister of Agriculture, spearheading Indonesia\'s rapid drive toward 100% food sovereignty. With extensive agricultural, scientific, and business expertise, Minister Amran leads the 3-million-hectare paddy expansion, modern irrigation upgrades, and farmer mechanization initiatives.',
    education: [
      'Hasanuddin University (UNHAS), Makassar — Bachelor of Agriculture and Master of Agricultural Science.',
      'Hasanuddin University (UNHAS) — Doctorate in Agricultural Science, graduating with highest academic distinction.'
    ],
    roles: [
      { title: 'Minister of Agriculture of Indonesia', period: 'October 2023 — Present' },
      { title: 'Head of National Food Sovereignty Taskforce', period: 'January 2024 — Present' },
      { title: 'Minister of Agriculture of Indonesia (First Term)', period: 'October 2014 — October 2019' },
      { title: 'Chairman of Indonesian Horticultural Society', period: 'July 2018 — October 2023' },
      { title: 'Founder & Chairman of Tiran Group Corporation', period: 'February 1995 — October 2014' },
      { title: 'Agricultural Technologist & Bio-Pesticide Inventor', period: 'June 1993 — Present' }
    ]
  },
  'jessica-lee': {
    biography: 'Bahlil Lahadalia serves as the Minister of Energy and Mineral Resources (ESDM). Having risen from grassroots beginnings in Maluku and Papua to leading national investment policy, Minister Bahlil drives the downstream processing of 26 natural commodities, solar grid development, and the mandatory B50 biofuel transition.',
    education: [
      'Port Numbay College of Economics (STIE Port Numbay), Jayapura — Bachelor of Science in Economics.',
      'Cenderawasih University (UNCEN), Papua — Master of Science in Development Economics.'
    ],
    roles: [
      { title: 'Minister of Energy and Mineral Resources', period: 'August 2024 — Present' },
      { title: 'Minister of Investment / Head of BKPM', period: 'April 2021 — August 2024' },
      { title: 'Head of Investment Coordinating Board (BKPM)', period: 'October 2019 — April 2021' },
      { title: 'General Chairman of Indonesian Young Entrepreneurs (HIPMI)', period: 'February 2015 — September 2019' },
      { title: 'Founder & Group Chairman of Rifa Capital', period: 'August 2003 — October 2019' },
      { title: 'National Industrial Downstreaming Taskforce Leader', period: 'January 2020 — Present' }
    ]
  },
  'james-clark': {
    biography: 'Lieutenant General (Ret.) Sjafrie Sjamsoeddin serves as the Minister of Defense. With over four decades of distinguished military and defense policy leadership, Minister Sjafrie leads the modernization of the Indonesian National Armed Forces (TNI), domestic defense manufacturing under DEFEND ID, and maritime border security.',
    education: [
      'Indonesian Military Academy (AKABRI), Magelang — Graduated in 1974.',
      'Army Command and General Staff College (SESKOAD) and International Defense Management Program at the US Naval Postgraduate School (Monterey, USA).'
    ],
    roles: [
      { title: 'Minister of Defense of Indonesia', period: 'October 2024 — Present' },
      { title: 'Special Advisor to the Minister of Defense', period: 'December 2019 — October 2024' },
      { title: 'Vice Minister of Defense of Indonesia', period: 'January 2010 — October 2014' },
      { title: 'Secretary General of the Ministry of Defense', period: 'April 2005 — January 2010' },
      { title: 'Commander of Military Area Command Jaya (Pangdam Jaya)', period: 'September 1997 — December 1998' },
      { title: 'Chief of TNI Information Center (Kapuspen TNI)', period: 'March 2002 — March 2005' }
    ]
  }
};

const profile = leadershipProfiles[member.id] || {
  biography: member.data.bio,
  education: [
    'Extensive public service and strategic leadership credentials in Indonesian national governance.'
  ],
  roles: [
    { title: member.data.title, period: '2024 — Present' }
  ]
};
---

<ContentLayout 
  title={`${member.data.name} - Leadership Profile | Asta Cita`}
  bannerTitle="Leadership Profile"
  bannerImage="/images/webflow/66dc04d965d12dc1cc9b4247_Team%20Bg%20Image.webp"
  currentPath="/team"
>
  <div class="section-team-details">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-large is-header">
          <div class="team-details-component">
            <div class="team-details-top-content-wrapper">
              <div class="team-details-image-wrapper reveal-left" style="background-image:url('/images/webflow/66dc1336a0bd34b5411c0bb8_Team%20Bg%20Image.jpg')">
                <img 
                  alt={member.data.name} 
                  class="team-details-image" 
                  loading="lazy" 
                  sizes="(max-width: 479px) 93vw, 384px" 
                  src={memberImageSrc} 
                />
              </div>
              <div class="team-details-right-content-wrapper reveal-right">
                <div class="team-details-right-content">
                  <h3 class="heading-style-h3">{member.data.name}</h3>
                  <div class="text-size-regular">{member.data.title}</div>
                </div>
                <div class="team-details w-richtext">
                  <h5>About {member.data.name}</h5>
                  <p>{member.data.bio}</p>
                </div>
                <div class="team-details-social-icon-wrapper">
                  <a class="team-details-social-icon w-inline-block" href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                    <img alt="Instagram" loading="lazy" src="/images/webflow/66dc04d83c0dbe656ece183f_Instagram%20Icon.svg" />
                  </a>
                  <a class="team-details-social-icon w-inline-block" href="https://x.com" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
                    <img alt="Twitter" loading="lazy" src="/images/webflow/66dc04d92d24625a20631f1d_Twitter%20Icon.svg" />
                  </a>
                  <a class="team-details-social-icon w-inline-block" href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                    <img alt="LinkedIn" loading="lazy" src="/images/webflow/66dc04d82f0c3749635de0f6_Linkedin%20Icon.svg" />
                  </a>
                  <a class="team-details-social-icon w-inline-block" href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                    <img alt="Facebook" loading="lazy" src="/images/webflow/66dc04d8185f32d46eb9df00_Facebook%20Icon.svg" />
                  </a>
                </div>
              </div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="team-details-bottom-content-wrapper">
              <div class="team-details w-richtext reveal-up">
                <h5>Personal Experience & Biography</h5>
                <p>{profile.biography}</p>
              </div>
              <div class="w-layout-grid team-grid reveal-scale">
                {profile.roles.map((roleItem) => (
                  <div class="team-details-content">
                    <h5 class="heading-style-h5">{roleItem.title}</h5>
                    <div class="text-size-regular">{roleItem.period}</div>
                  </div>
                ))}
              </div>
              <div class="team-details _2nd w-richtext reveal-up">
                <h5>Educational Experience</h5>
                {profile.education.map((edu) => (
                  <p>{edu}</p>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>
