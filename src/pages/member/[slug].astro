---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';
import { entrySlug } from '@/lib/entry';

export async function getStaticPaths() {
  const team = await getCollection('team');

  return team.map(member => ({
    params: { slug: entrySlug(member) },
    props: { member },
  }));
}

const { member } = Astro.props;

const memberSlug = entrySlug(member);

const memberImages = {
  'john-smith': '/images/assets/66de885235a491ec7c9579d4_Team%20Image%206.webp',
  'sarah-johnson': '/images/assets/66de8849ae04b9432a83ed16_Team%20Image%205.webp',
  'michael-brown': '/images/assets/66de8840477d16d8930afdba_Team%20Image%204.webp',
  'david-wilson': '/images/assets/66de88373555ab75c632122c_Team%20Image%203.webp',
  'jessica-lee': '/images/assets/66de882ef48421d2f55b6983_Team%20Image%202.webp',
  'james-clark': '/images/assets/66de882483ff8257a260072a_Team%20Image%201.webp',
} as const;

type MemberSlug = keyof typeof memberImages;

function isMemberSlug(value: string): value is MemberSlug {
  return value in memberImages;
}

interface LeaderRole {
  readonly title: string;
  readonly period: string;
}

interface LeaderProfile {
  readonly biography: string;
  readonly education: readonly string[];
  readonly roles: readonly LeaderRole[];
}

const knownMemberImage = isMemberSlug(memberSlug) ? memberImages[memberSlug] : undefined;

const memberImageSrc = knownMemberImage ?? (member.data.image ? member.data.image.src : `/images/team/${memberSlug}.webp`);

const leadershipProfiles: Record<MemberSlug, LeaderProfile> = {
  'john-smith': {
    biography: 'Presiden Republik Indonesia memimpin jalannya pemerintahan Kabinet Merah Putih dengan amanat Asta Cita menuju Indonesia Emas 2045. Dedikasi kepemimpinan berfokus pada ketahanan nasional, swasembada pangan dan energi mandiri, peningkatan taraf gizi generasi penerus bangsa, hilirisasi industri mineral strategis, serta penegakan kedaulatan NKRI.',
    education: [
      'Akademi Militer Nasional (AKABRI), Magelang — Lulusan tahun 1974 dengan predikat keunggulan taktik dan kepemimpinan teritorial.',
      'Pendidikan Lanjutan Perwira dan Manajemen Pertahanan Strategis Nasional.'
    ],
    roles: [
      { title: 'Presiden Republik Indonesia', period: 'Oktober 2024 — Sekarang' },
      { title: 'Menteri Pertahanan Republik Indonesia', period: 'Oktober 2019 — Oktober 2024' },
      { title: 'Ketua Umum Dewan Pembina Partai Gerindra', period: 'September 2014 — Sekarang' },
      { title: 'Panglima Komando Cadangan Strategis TNI-AD (Kostrad)', period: '1998' },
      { title: 'Komandan Jenderal Komando Pasukan Khusus (Kopassus)', period: '1995 — 1998' },
      { title: 'Ketua Umum Himpunan Kerukunan Tani Indonesia (HKTI)', period: '2004 — 2015' }
    ]
  },
  'sarah-johnson': {
    biography: 'Kementerian Komunikasi dan Digital Republik Indonesia (Kemkomdigi) mengemban mandat menyelenggarakan infrastruktur konektivitas digital terpadu, penerapan GovTech INA Digital terintegrasi, literasi teknologi pemuda, dan penjagaan kedaulatan siber nasional di seluruh 38 provinsi.',
    education: [
      'Pilar 1: Integrasi portal layanan publik nasional melalui arsitektur GovTech INA Digital.',
      'Pilar 2: Penguatan infrastruktur jaringan internet cepat dan pemerataan digitalisasi daerah 3T.',
      'Pilar 3: Pengembangan talenta digital muda Indonesia dan hilirisasi kecerdasan buatan nasional.'
    ],
    roles: [
      { title: 'Penerapan GovTech Terpadu INA Digital', period: '2024 — 2029' },
      { title: 'Percepatan Konektivitas Digital Wilayah 3T', period: '2024 — 2029' },
      { title: 'Perlindungan Data Pribadi & Keamanan Siber', period: '2024 — 2029' },
      { title: 'Program Literasi & Sertifikasi Digital Pemuda', period: '2024 — 2029' }
    ]
  },
  'michael-brown': {
    biography: 'Badan Gizi Nasional (BGN) merupakan lembaga pemerintah non-kementerian setingkat menteri yang dibentuk berdasarkan amanat Presiden untuk mengeksekusi program prioritas Makan Bergizi Gratis (MBG) bagi 82,9 juta anak sekolah, balita, dan ibu hamil guna menuntaskan stunting dan membangun generasi unggul 2045.',
    education: [
      'Pilar 1: Pembangunan Satuan Pelayanan Pemenuhan Gizi (SPMBG) higienis berstandar ketat.',
      'Pilar 2: Penyerapan bahan pangan segar dari petani, peternak, dan nelayan lokal di setiap kecamatan.',
      'Pilar 3: Pengawasan nutrisi berkala dan evaluasi status gizi anak sekolah di 38 provinsi.'
    ],
    roles: [
      { title: 'Penyaluran Nutrisi Harian 82,9 Juta Anak', period: '2024 — 2029' },
      { title: 'Pemberantasan Stunting Anak & Balita Nasional', period: '2024 — 2029' },
      { title: 'Pemberdayaan Rantai Pasok Petani & Peternak Lokal', period: '2024 — 2029' },
      { title: 'Standarisasi Higienitas Dapur Satuan Pelayanan Gizi', period: '2024 — 2029' }
    ]
  },
  'david-wilson': {
    biography: 'Kementerian Pertanian Republik Indonesia (Kementan) memimpin pencapaian kemandirian pangan nasional (Swasembada Pangan) dengan target eliminasi ketergantungan impor beras dan jagung melalui optimalisasi lahan sawah, modernisasi pompanisasi air, subsidi pupuk langsung, dan mekanisasi pertanian.',
    education: [
      'Pilar 1: Cetak sawah dan intensifikasi 3 juta hektar lahan produktif di luar Pulau Jawa.',
      'Pilar 2: Revitalisasi pompanisasi sungai dan jaringan irigasi tersier persawahan rakyat.',
      'Pilar 3: Digitalisasi penyaluran pupuk bersubsidi langsung ke rekening petani tanpa perantara.'
    ],
    roles: [
      { title: 'Pencapaian Swasembada Beras & Jagung Mandiri', period: '2024 — 2029' },
      { title: 'Penyaluran Pupuk Bersubsidi Langsung ke Petani', period: '2024 — 2029' },
      { title: 'Program Pompanisasi Lahan Kering & Sawah Tadah Hujan', period: '2024 — 2029' },
      { title: 'Penguatan Cadangan Beras Pemerintah (CBP) Bulog', period: '2024 — 2029' }
    ]
  },
  'jessica-lee': {
    biography: 'Kementerian Energi dan Sumber Daya Mineral RI (Kementerian ESDM) mengawal kedaulatan energi nasional dan akselerasi hilirisasi industri bernilai tambah tinggi atas 26 komoditas mineral dan tambang strategis, bersamaan dengan implementasi mandatori biodiesel B50 dan kelistrikan pedesaan.',
    education: [
      'Pilar 1: Hilirisasi smelter domestik untuk nikel, tembaga, bauksit, dan mineral kritis.',
      'Pilar 2: Implementasi bertahap mandatori bahan bakar nabati biodiesel B40 hingga B50.',
      'Pilar 3: Swasembada kelistrikan hijau dan transmisi interkoneksi jaringan listrik nusantara.'
    ],
    roles: [
      { title: 'Mandatori Mandiri Bioenergi Biodiesel B50', period: '2024 — 2029' },
      { title: 'Hilirisasi Penuh 26 Komoditas Mineral Strategis', period: '2024 — 2029' },
      { title: 'Pemerataan Kelistrikan Desa 100% Nusantara', period: '2024 — 2029' },
      { title: 'Peningkatan Lifting Minyak & Gas Bumi Nasional', period: '2024 — 2029' }
    ]
  },
  'james-clark': {
    biography: 'Kementerian Pertahanan Republik Indonesia (Kemhan) memimpin pemantapan kedaulatan wilayah tanah air, modernisasi Alutsista TNI tiga matra (AD, AL, AU), pengamanan laut kepulauan Zona Ekonomi Eksklusif (ZEE), dan penguatan industri pertahanan mandiri di bawah holding DEFEND ID.',
    education: [
      'Pilar 1: Modernisasi radar maritim, kapal perang fregat, dan jet tempur pertahanan udara.',
      'Pilar 2: Kemandirian produksi amunisi, ranpur, dan alpalhankam dalam negeri melalui DEFEND ID.',
      'Pilar 3: Penguatan doktrin pertahanan semesta dan kesiapsiagaan komponen cadangan nasional.'
    ],
    roles: [
      { title: 'Modernisasi Alutsista Tiga Matra TNI', period: '2024 — 2029' },
      { title: 'Pengamanan Perbatasan Maritim ZEE & Pulau Terluar', period: '2024 — 2029' },
      { title: 'Kemandirian Industri Pertahanan Holding DEFEND ID', period: '2024 — 2029' },
      { title: 'Peningkatan Kesejahteraan Prajurit & Veteran RI', period: '2024 — 2029' }
    ]
  }
};

const profile = leadershipProfiles[memberSlug] || {
  biography: member.data.bio,
  education: [
    'Pilar 1: Pelaksanaan tata kelola program strategis nasional secara transparan dan berintegritas.',
    'Pilar 2: Sinergi lintas kementerian/lembaga demi percepatan sasaran Asta Cita Indonesia Emas 2045.'
  ],
  roles: [
    { title: member.data.title, period: '2024 — 2029' }
  ]
};
---

<ContentLayout 
  title={`Kabinet Merah Putih — ${member.data.name}`}
  bannerTitle="Program Prioritas"
  bannerImage="/images/assets/66dc04d965d12dc1cc9b4247_Team%20Bg%20Image.webp"
  currentPath="/team"
>
  <div class="section-team-details">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-large is-header">
          <div class="team-details-component">
            <div class="team-details-top-content-wrapper">
              <div class="team-details-image-wrapper reveal-left" style="background-image:url('/images/assets/66dc1336a0bd34b5411c0bb8_Team%20Bg%20Image.jpg')">
                <img 
                  alt={member.data.name} 
                  class="team-details-image" 
                  loading="lazy" 
                  sizes="(max-width: 479px) 93vw, 384px" 
                  src={memberImageSrc} 
                />
              </div>
              <div class="team-details-right-content-wrapper reveal-right">
                <div class="team-details-right-content">
                  <h3 class="heading-style-h3">{member.data.name}</h3>
                  <div class="text-size-regular text-brand-blue font-medium">{member.data.title}</div>
                </div>
                <div class="team-details w-richtext">
                  <h5>Ringkasan Mandat</h5>
                  <p>{member.data.bio}</p>
                </div>
                <div class="team-details-social-icon-wrapper">
                  <a class="team-details-social-icon w-inline-block" href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                    <img alt="Instagram" loading="lazy" src="/images/assets/66dc04d83c0dbe656ece183f_Instagram%20Icon.svg" />
                  </a>
                  <a class="team-details-social-icon w-inline-block" href="https://x.com" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
                    <img alt="Twitter" loading="lazy" src="/images/assets/66dc04d92d24625a20631f1d_Twitter%20Icon.svg" />
                  </a>
                  <a class="team-details-social-icon w-inline-block" href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                    <img alt="LinkedIn" loading="lazy" src="/images/assets/66dc04d82f0c3749635de0f6_Linkedin%20Icon.svg" />
                  </a>
                  <a class="team-details-social-icon w-inline-block" href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                    <img alt="Facebook" loading="lazy" src="/images/assets/66dc04d8185f32d46eb9df00_Facebook%20Icon.svg" />
                  </a>
                </div>
              </div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="team-details-bottom-content-wrapper">
              <div class="team-details w-richtext reveal-up">
                <h5>{memberSlug === 'john-smith' ? 'Profil & Dedikasi Kepemimpinan' : 'Mandat & Gambaran Strategis'}</h5>
                <p>{profile.biography}</p>
              </div>
              <div class="w-layout-grid team-grid reveal-scale">
                {profile.roles.map((roleItem) => (
                  <div class="team-details-content">
                    <h5 class="heading-style-h5">{roleItem.title}</h5>
                    <div class="text-size-regular">{roleItem.period}</div>
                  </div>
                ))}
              </div>
              <div class="team-details _2nd w-richtext reveal-up">
                <h5>{memberSlug === 'john-smith' ? 'Visi & Landasan Kepemimpinan' : 'Fokus Program & Indikator Keberhasilan'}</h5>
                {profile.education.map((edu) => (
                  <p>{edu}</p>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>
