---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Sort by date (assuming publishDate exists)
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());
---

<ContentLayout title="Blog">
  <div class="bg-neutral-white-200 py-16 text-center">
    <div class="max-w-container mx-auto px-4">
      <h1 class="text-4xl md:text-5xl font-bold font-lora text-neutral-black-900 reveal-fade">Blog</h1>
    </div>
  </div>

  <div class="max-w-container mx-auto px-4 py-12">
    <!-- Category Filter Buttons -->
    <div class="flex flex-wrap gap-4 justify-center mb-12 reveal-fade">
      <a href="/blog" class="px-6 py-2 rounded-[0.75rem] bg-brand-blue text-neutral-white font-medium">All</a>
      <a href="/blog/category/policy" class="px-6 py-2 rounded-[0.75rem] bg-neutral-white-300 text-neutral-black-700 hover:bg-brand-blue hover:text-neutral-white transition-colors">Policy</a>
      <a href="/blog/category/advocacy" class="px-6 py-2 rounded-[0.75rem] bg-neutral-white-300 text-neutral-black-700 hover:bg-brand-blue hover:text-neutral-white transition-colors">Advocacy</a>
      <a href="/blog/category/community" class="px-6 py-2 rounded-[0.75rem] bg-neutral-white-300 text-neutral-black-700 hover:bg-brand-blue hover:text-neutral-white transition-colors">Community</a>
    </div>

    <!-- Blog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map((post) => (
        <article class="rounded-[0.75rem] bg-neutral-white p-5 shadow-subtle flex flex-col reveal-fade">
          <a href={`/post/${post.slug}`} class="block overflow-hidden rounded-lg mb-4 card-image-hover">
            <img src={post.data.image || '/images/default-blog.jpg'} alt={post.data.title} class="w-full h-48 object-cover transition-transform duration-300" />
          </a>
          <div class="mb-2">
            <span class="inline-block px-3 py-1 bg-neutral-white-200 text-brand-blue text-sm font-medium rounded-full">{post.data.category}</span>
          </div>
          <a href={`/post/${post.slug}`}>
            <h5 class="text-xl font-bold font-lora text-neutral-black-900 mb-2 hover:text-brand-blue transition-colors">{post.data.title}</h5>
          </a>
          <p class="text-neutral-black-600 mb-4 flex-grow">{post.data.excerpt}</p>
          <div class="flex items-center text-sm text-neutral-black-500 mt-auto">
            <span>{new Date(post.data.publishDate).toLocaleDateString()}</span>
            <span class="mx-2">•</span>
            <span>{post.data.readTime}</span>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- CTA Section -->
  <section class="bg-brand-blue py-16 text-center text-neutral-white">
    <div class="max-w-container mx-auto px-4 reveal-fade">
      <h2 class="text-3xl md:text-4xl font-bold font-lora mb-6">Take action for change.</h2>
      <a href="/donate" class="inline-block px-8 py-4 bg-brand-red text-neutral-white font-medium rounded-[0.75rem] hover:bg-opacity-90 transition-all">Support Our Cause</a>
    </div>
  </section>
</ContentLayout>

<style>
  .card-image-hover:hover img {
    transform: scale(1.05);
  }
</style>
