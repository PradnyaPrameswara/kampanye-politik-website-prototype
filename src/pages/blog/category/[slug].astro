---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = await getCollection('categories');

  return categories.map(category => ({
    params: { slug: category.data.slug || category.id },
    props: { category },
  }));
}

const { category } = Astro.props;

const { slug } = Astro.params;

const allPosts = await getCollection('blog');

const getCategoryId = (cat: { id: string } | string) => ('id' in Object(cat) ? Object(cat).id : String(cat || ''));

const currentCatId = (category.data.slug || category.id || '').toLowerCase();

const blogImages = {
  'understanding-recent-policy-changes': '/images/webflow/66de845af00d0586abb5ff9f_Blog%20Image%206.jpg',
  'building-strong-advocacy-coalitions': '/images/webflow/66de844253d3899d0b7ea2ae_Blog%20Image%205.jpg',
  'community-initiatives-making-a-difference': '/images/webflow/66de84243555ab75c62dcfa4_Blog%20Image%204.jpg',
  'impact-of-policy-on-local-communities': '/images/webflow/66de840153d3899d0b7e7164_Blog%20Image%203.jpg',
  'effective-advocacy-strategies-for-success': '/images/webflow/66de83db9b602e1b2f5a8425_Blog%20Image%202.jpg',
  'stories-of-community-impact-and-change': '/images/webflow/66de82a68945e61eaf28d812_Blog%20Image%201.jpg',
} as const;

const filteredPosts = allPosts
  .filter(post => getCategoryId(post.data.category).toLowerCase() === currentCatId)
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());
---

<ContentLayout 
  title={`Asta Cita - ${category.data.name} | President Prabowo Subianto Flagship Programs`} 
  bannerTitle="Policy Insights & Articles" 
  bannerImage="/images/webflow/66dc04d841e23610d102b9e4_Blog%20Bg%20Image.webp"
  currentPath="/blog"
>
  <!-- Section Blog -->
  <div class="section-blog">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium is-header">
          <div class="blog-component is-blog">
            <div class="blog-top-content-wrapper">
              <div class="blog-top-content reveal-left">
                <h2 class="heading-style-h2">Explore updates and analysis on national programs and Asta Cita priorities.</h2>
              </div>
              <div class="blog-category-collection-list-wrapper w-dyn-list reveal-right">
                <div class="blog-category-collection-list w-dyn-items" role="list">
                  <div class="blog-category-collection-list-item w-dyn-item" role="listitem">
                    <a class="blog-category-button w-inline-block" href="/blog">
                      <div>All Blog</div>
                    </a>
                    <a class={`blog-category-button w-inline-block ${slug === 'policy' ? 'w--current' : ''}`} href="/blog/category/policy">
                      <div>Policy</div>
                    </a>
                  </div>
                  <div class="blog-category-collection-list-item w-dyn-item" role="listitem">
                    <a class={`blog-category-button w-inline-block ${slug === 'advocacy' ? 'w--current' : ''}`} href="/blog/category/advocacy">
                      <div>Advocacy</div>
                    </a>
                  </div>
                  <div class="blog-category-collection-list-item w-dyn-item" role="listitem">
                    <a class={`blog-category-button w-inline-block ${slug === 'community' ? 'w--current' : ''}`} href="/blog/category/community">
                      <div>Community</div>
                    </a>
                  </div>
                </div>
              </div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="blog-collection-list-wrapper w-dyn-list">
              <div class="blog-collection-list is-blog w-dyn-items" role="list">
                {filteredPosts.map((post) => (
                  <div class="blog-collection-item w-dyn-item" role="listitem">
                    <div class="blog-card reveal-scale">
                      <div class="blog-image-wrapper">
                        <img 
                          alt={post.data.title} 
                          class="blog-image" 
                          loading="lazy" 
                          sizes="(max-width: 479px) 88vw, (max-width: 767px) 41vw, (max-width: 991px) 37vw, 18vw" 
                          src={blogImages[post.slug] || post.data.image} 
                        />
                      </div>
                      <div class="blog-card-content-wrapper">
                        <div class="text-size-small">
                          {new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                        </div>
                        <h5 class="heading-style-h5">{post.data.title}</h5>
                        <div class="blog-card-content">
                          <a class="blog-button w-inline-block" href={`/post/${post.slug}`}>
                            <div>Read More</div>
                            <img alt="" class="arrow" loading="lazy" src="/images/webflow/66dc04d84a2c1e5e023ff6fd_Blog%20Arrow.svg" />
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section CTA -->
  <div class="section-cta">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium padding-bottom-large">
          <div class="cta-component reveal-scale">
            <div class="cta-content-wrapper">
              <h2 class="heading-style-h2">Take action for change.</h2>
              <a class="button w-inline-block" href="/contact"><div>Join us now</div></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>
