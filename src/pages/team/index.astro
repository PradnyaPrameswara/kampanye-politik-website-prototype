---
import ContentLayout from '@/layouts/ContentLayout.astro';
import FaqAccordion from '@/components/react/FaqAccordion';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

const blogPosts = allPosts.slice(0, 2);

const blogImages = {
  'understanding-recent-policy-changes': '/images/assets/66de845af00d0586abb5ff9f_Blog%20Image%206.jpg',
  'building-strong-advocacy-coalitions': '/images/assets/66de844253d3899d0b7ea2ae_Blog%20Image%205.jpg',
  'community-initiatives-making-a-difference': '/images/assets/66de84243555ab75c62dcfa4_Blog%20Image%204.jpg',
  'impact-of-policy-on-local-communities': '/images/assets/66de840153d3899d0b7e7164_Blog%20Image%203.jpg',
  'effective-advocacy-strategies-for-success': '/images/assets/66de83db9b602e1b2f5a8425_Blog%20Image%202.jpg',
  'stories-of-community-impact-and-change': '/images/assets/66de82a68945e61eaf28d812_Blog%20Image%201.jpg',
} as const;

const teamMembers = [
  {
    name: 'Prabowo Subianto',
    role: 'President of the Republic of Indonesia',
    slug: 'john-smith',
    image: '/images/assets/66de885235a491ec7c9579d4_Team%20Image%206.webp',
  },
  {
    name: 'Gibran Rakabuming Raka',
    role: 'Vice President of the Republic of Indonesia',
    slug: 'sarah-johnson',
    image: '/images/assets/66de8849ae04b9432a83ed16_Team%20Image%205.webp',
  },
  {
    name: 'Prof. Dadan Hindayana',
    role: 'Head of National Nutrition Agency (BGN)',
    slug: 'michael-brown',
    image: '/images/assets/66de8840477d16d8930afdba_Team%20Image%204.webp',
  },
  {
    name: 'Dr. Andi Amran Sulaiman',
    role: 'Minister of Agriculture',
    slug: 'david-wilson',
    image: '/images/assets/66de88373555ab75c632122c_Team%20Image%203.webp',
  },
  {
    name: 'Bahlil Lahadalia',
    role: 'Minister of Energy and Mineral Resources',
    slug: 'jessica-lee',
    image: '/images/assets/66de882ef48421d2f55b6983_Team%20Image%202.webp',
  },
  {
    name: 'Lt. Gen. (Ret.) Sjafrie Sjamsoeddin',
    role: 'Minister of Defense',
    slug: 'james-clark',
    image: '/images/assets/66de882483ff8257a260072a_Team%20Image%201.webp',
  },
];
---

<ContentLayout 
  title="Asta Cita - Cabinet Leadership | President Prabowo Subianto Flagship Programs" 
  bannerTitle="Cabinet Leadership" 
  bannerImage="/images/assets/66dc04d965d12dc1cc9b4247_Team%20Bg%20Image.webp"
  currentPath="/team"
>
  <!-- Section Team -->
  <div class="section-team">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium is-header">
          <div class="team-component">
            <div class="team-top-content-wrapper reveal-down">
              <div class="team-top-left-content-wrapper">
                <div class="headline"><div class="dot"></div><div>Cabinet Leadership</div></div>
                <h2 class="heading-style-h2">Building a sovereign and self-reliant nation together.</h2>
              </div>
              <div class="text-size-regular">Key national leaders driving the strategic execution of Asta Cita: from childhood nutrition and agricultural self-sufficiency to downstream industries and national defense.</div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="team-collection-list-wrapper w-dyn-list reveal-up">
              <div class="team-collection-list w-dyn-items" role="list">
                {teamMembers.map((member) => (
                  <div class="team-collection-list-item w-dyn-item" role="listitem">
                    <a class="team-card w-inline-block" href={`/member/${member.slug}`}>
                      <div class="team-image-wrapper" style="background-image:url('/images/assets/66dc1336a0bd34b5411c0bb8_Team%20Bg%20Image.jpg')">
                        <img 
                          alt={member.name} 
                          class="team-image" 
                          loading="lazy" 
                          sizes="(max-width: 479px) 93vw, (max-width: 767px) 94vw, (max-width: 991px) 46vw, 30vw" 
                          src={member.image} 
                        />
                      </div>
                      <div class="team-card-content-wrapper">
                        <div class="team-card-content">
                          <h5 class="heading-style-h5 text-color-white">{member.name}</h5>
                          <img alt="" loading="lazy" src="/images/assets/66dc04d922177f0428b4cc55_Team%20Arrow.svg" />
                        </div>
                        <div class="text-size-regular text-color-white">{member.role}</div>
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section FAQ -->
  <FaqAccordion client:visible />

  <!-- Section Blog -->
  <div class="section-blog">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium padding-bottom-large">
          <div class="blog-component">
            <div class="blog-left-content-wrapper reveal-scale">
              <div class="blog-left-top-content-wrapper">
                <div class="headline _2nd"><div class="dot"></div><div>Policy Insights</div></div>
                <div class="blog-left-top-content">
                  <h2 class="heading-style-h2 text-color-white">Explore key updates on national policy and execution.</h2>
                  <div class="text-size-regular text-color-white-200">Deep dives into the implementation of Makan Bergizi Gratis, agricultural expansion, and industrial downstreaming.</div>
                </div>
                <a class="button w-inline-block" href="/blog"><div>View more</div></a>
              </div>
            </div>
            <div class="blog-right-content-wrapper">
              <div class="blog-collection-list-wrapper w-dyn-list">
                <div class="blog-collection-list w-dyn-items" role="list">
                  {blogPosts.map((post) => (
                    <div class="blog-collection-item w-dyn-item" role="listitem">
                      <div class="blog-card reveal-scale">
                        <div class="blog-image-wrapper">
                          <img 
                            alt={post.data.title} 
                            class="blog-image" 
                            loading="lazy" 
                            sizes="100vw" 
                            src={blogImages[post.slug as keyof typeof blogImages] || '/images/assets/66de845af00d0586abb5ff9f_Blog%20Image%206.jpg'} 
                          />
                        </div>
                        <div class="blog-card-content-wrapper">
                          <div class="text-size-small">
                            {new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                          </div>
                          <a class="blog-text-link w-inline-block" href={`/post/${post.slug}`}>
                            <h5 class="heading-style-h5">{post.data.title}</h5>
                          </a>
                          <div class="blog-card-content">
                            <a class="blog-button w-inline-block" href={`/post/${post.slug}`}>
                              <div>Read More</div>
                              <img alt="" class="arrow" loading="lazy" src="/images/assets/66dc04d84a2c1e5e023ff6fd_Blog%20Arrow.svg" />
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>
