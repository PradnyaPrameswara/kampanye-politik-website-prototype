---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const objectives = await getCollection('objectives');

  return objectives.map(objective => ({
    params: { slug: objective.slug || objective.id },
    props: { objective },
  }));
}

const { objective } = Astro.props;

const { Content } = await objective.render();

const slug = objective.slug || objective.id;

const objectiveImages = {
  'advancing-social-equity-and-justice': '/images/webflow/66de86499b602e1b2f5cfbc1_Objectives%20Image%206.jpg',
  'protecting-human-rights-and-freedoms': '/images/webflow/66de8604cdbecf88f8bdcd34_Objectives%20Image%205.jpg',
  'improving-healthcare-access-and-quality': '/images/webflow/66de85ebcdae96c41a0e5b3f_Objectives%20Image%204.jpg',
  'boosting-national-security-and-safety': '/images/webflow/66de85c7f4911980aa633be9_Objectives%20Image%203.jpg',
  'ensuring-fair-legal-and-justice-systems': '/images/webflow/66de859d80ec78184905d9b3_Objectives%20Image%202.jpg',
  'strengthening-economic-opportunity': '/images/webflow/66de850f20911f1251f963e9_Objectives%20Image%201.jpg',
} as const;

type ObjectiveSlug = keyof typeof objectiveImages;

// SAFETY: slug is confirmed to be an existing key in objectiveImages
const knownImage = slug in objectiveImages ? objectiveImages[slug as ObjectiveSlug] : undefined;

const imageSrc = knownImage ?? (objective.data.image ? objective.data.image.src : `/images/objectives/${slug}.jpg`);
---

<ContentLayout 
  title={`${objective.data.title} - Objectives | CivicUnity`}
  bannerTitle="Objectives"
  bannerImage="/images/webflow/66dc04da39706fc65e5ae286_Objectives%20Bg%20Image.webp"
  currentPath="/objective"
>
  <div class="section-objective-details">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-large is-header">
          <div class="objective-details-component">
            <div class="objective-details-top-content-wrapper reveal-down">
              <div class="objective-details-top-content">
                <h2 class="heading-style-h2">{objective.data.title}</h2>
              </div>
              <div class="objective-details-top-content">
                <p class="text-size-regular">{objective.data.description}</p>
              </div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="objective-details-image-wrapper reveal-scale">
              <img 
                alt={objective.data.title} 
                class="objective-details-image" 
                loading="lazy" 
                sizes="(max-width: 479px) 93vw, (max-width: 991px) 94vw, 1200px" 
                src={imageSrc} 
              />
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="objective-details w-richtext reveal-up">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>
