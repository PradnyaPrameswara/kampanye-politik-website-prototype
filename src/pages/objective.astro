---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';

const allObjectives = await getCollection('objectives');

const allPosts = await getCollection('blog');

const blogPosts = allPosts.slice(0, 2);

const objectiveImages = {
  'advancing-social-equity-and-justice': '/images/webflow/66de86499b602e1b2f5cfbc1_Objectives%20Image%206.jpg',
  'protecting-human-rights-and-freedoms': '/images/webflow/66de8604cdbecf88f8bdcd34_Objectives%20Image%205.jpg',
  'improving-healthcare-access-and-quality': '/images/webflow/66de85ebcdae96c41a0e5b3f_Objectives%20Image%204.jpg',
  'boosting-national-security-and-safety': '/images/webflow/66de85c7f4911980aa633be9_Objectives%20Image%203.jpg',
  'ensuring-fair-legal-and-justice-systems': '/images/webflow/66de859d80ec78184905d9b3_Objectives%20Image%202.jpg',
  'strengthening-economic-opportunity': '/images/webflow/66de850f20911f1251f963e9_Objectives%20Image%201.jpg',
} as const;

// Preserve exact Webflow order
const orderedSlugs = [
  'advancing-social-equity-and-justice',
  'protecting-human-rights-and-freedoms',
  'improving-healthcare-access-and-quality',
  'boosting-national-security-and-safety',
  'ensuring-fair-legal-and-justice-systems',
  'strengthening-economic-opportunity',
] as const;

const sortedObjectives = orderedSlugs.flatMap(slug => {
  const objective = allObjectives.find(o => o.slug === slug);

  return objective ? [objective] : [];
});
---

<ContentLayout 
  title="CivicUnity - Objectives" 
  bannerTitle="Objectives" 
  bannerImage="/images/webflow/66dc04da39706fc65e5ae286_Objectives%20Bg%20Image.webp"
  currentPath="/objective"
>
  <!-- Section Objective -->
  <div class="section-objective">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium is-header">
          <div class="objective-component">
            <div class="objective-top-content-wrapper">
              <div class="objective-top-left-content-wrapper">
                <h2 class="heading-style-h2">Guiding our nation with purposeful strategic objectives.</h2>
              </div>
              <p class="text-size-regular">Arcu duis in venenatis turpis phasellus morbi nulla eu purus. Viverra enim arcu magna adipiscing suscipit eu viverra mollis vitae.</p>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="objective-collection-list-wrapper w-dyn-list">
              <div class="objective-collection-list w-dyn-items" role="list">
                {sortedObjectives.map((item) => (
                  <div class="objective-collection-item w-dyn-item" role="listitem">
                    <a class="objective-card w-inline-block" href={`/objectives/${item.slug}`}>
                      <div class="objective-image-wrapper">
                        <img 
                          alt={item.data.title} 
                          class="objective-image" 
                          loading="lazy" 
                          sizes="(max-width: 767px) 95vw, (max-width: 991px) 47vw, 39vw" 
                          src={objectiveImages[item.slug] || item.data.image} 
                        />
                      </div>
                      <div class="objective-card-content-wrapper">
                        <h5 class="heading-style-h5">{item.data.title}</h5>
                        <p class="text-size-regular">{item.data.description}</p>
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section CTA -->
  <div class="section-cta">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="cta-component">
            <div class="cta-content-wrapper">
              <h2 class="heading-style-h2">Take action for change.</h2>
              <a class="button w-inline-block" href="/contact"><div>Join us now</div></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Blog -->
  <div class="section-blog">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium padding-bottom-large">
          <div class="blog-component">
            <div class="blog-left-content-wrapper">
              <div class="blog-left-top-content-wrapper">
                <div class="headline _2nd"><div class="dot"></div><div>About us</div></div>
                <div class="blog-left-top-content">
                  <h2 class="heading-style-h2 text-color-white">Explore our blog for current political updates.</h2>
                  <div class="text-size-regular text-color-white-200">Ut malesuada non in tristique at. Ut sit nec vitae ut. Sagittis ut eu aliquet sit vulputate</div>
                </div>
                <a class="button w-inline-block" href="/blog"><div>View more</div></a>
              </div>
            </div>
            <div class="blog-right-content-wrapper">
              <div class="blog-collection-list-wrapper w-dyn-list">
                <div class="blog-collection-list w-dyn-items" role="list">
                  {blogPosts.map((post) => (
                    <div class="blog-collection-item w-dyn-item" role="listitem">
                      <div class="blog-card">
                        <div class="blog-image-wrapper">
                          <img alt={post.data.title} class="blog-image" loading="lazy" sizes="100vw" src={post.data.image} />
                        </div>
                        <div class="blog-card-content-wrapper">
                          <div class="text-size-small">
                            {new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                          </div>
                          <a class="blog-text-link w-inline-block" href={`/post/${post.slug}`}>
                            <h5 class="heading-style-h5">{post.data.title}</h5>
                          </a>
                          <div class="blog-card-content">
                            <a class="blog-button w-inline-block" href={`/post/${post.slug}`}>
                              <div>Read More</div>
                              <img alt="" class="arrow" loading="lazy" src="/images/webflow/66dc04d84a2c1e5e023ff6fd_Blog%20Arrow.svg" />
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>
