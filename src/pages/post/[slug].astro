---
import ContentLayout from '@/layouts/ContentLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map(entry => ({
    params: { slug: entry.slug || entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const { Content } = await entry.render();

const slug = entry.slug || entry.id;

const blogImages = {
  'understanding-recent-policy-changes': '/images/webflow/66de845af00d0586abb5ff9f_Blog%20Image%206.jpg',
  'building-strong-advocacy-coalitions': '/images/webflow/66de844253d3899d0b7ea2ae_Blog%20Image%205.jpg',
  'community-initiatives-making-a-difference': '/images/webflow/66de84243555ab75c62dcfa4_Blog%20Image%204.jpg',
  'impact-of-policy-on-local-communities': '/images/webflow/66de840153d3899d0b7e7164_Blog%20Image%203.jpg',
  'effective-advocacy-strategies-for-success': '/images/webflow/66de83db9b602e1b2f5a8425_Blog%20Image%202.jpg',
  'stories-of-community-impact-and-change': '/images/webflow/66de82a68945e61eaf28d812_Blog%20Image%201.jpg',
} as const;

type BlogSlug = keyof typeof blogImages;

// SAFETY: slug is confirmed to be an existing key in blogImages
const knownImage = slug in blogImages ? blogImages[slug as BlogSlug] : undefined;

const postImageSrc = knownImage ?? (entry.data.image ? entry.data.image.src : `/images/blog/${slug}.jpg`);

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.publishDate);

const rawCat = 'id' in entry.data.category ? entry.data.category.id : String(entry.data.category || 'Policy');

const categoryName = rawCat.charAt(0).toUpperCase() + rawCat.slice(1);
---

<ContentLayout 
  title={`${entry.data.title} - Policy Analysis | Asta Cita`}
  bannerTitle="Policy Insights"
  bannerImage="/images/webflow/66dc04d841e23610d102b9e4_Blog%20Bg%20Image.webp"
  currentPath="/blog"
>
  <div class="section-blog-details">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-large is-header">
          <div class="blog-details-component">
            <div class="blog-details-top-content-wrapper">
              <div class="blog-details-top-left-content-wrapper reveal-left">
                <div class="blog-details-left-top-content">
                  <div class="text-size-small">{formattedDate}</div>
                  <div class="text-size-small">{entry.data.readTime}</div>
                  <div class="text-size-small">{categoryName}</div>
                </div>
                <div class="blog-details-top-left-content">
                  <h2 class="heading-style-h2">{entry.data.title}</h2>
                  <p class="text-size-regular">{entry.data.excerpt}</p>
                </div>
              </div>
              <div class="blog-details-image-wrapper reveal-right">
                <img 
                  alt={entry.data.title} 
                  class="blog-details-image" 
                  loading="lazy" 
                  sizes="(max-width: 479px) 93vw, (max-width: 991px) 94vw, 593px" 
                  src={postImageSrc} 
                />
              </div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="blog-details w-richtext reveal-up">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</ContentLayout>
