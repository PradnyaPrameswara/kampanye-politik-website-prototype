---

<ContentLayout title="Kabinet Merah Putih — Kredit Gambar" description="Atribusi dan lisensi gambar yang digunakan pada situs ini." bannerTitle="Kredit Gambar" currentPath="/kredit">
  <div class="section-padding padding-global">
    <div class="container-large">
      <p class="text-size-regular">
        Gambar-gambar pada situs ini bersumber dari Wikimedia Commons dan lembaga pemerintah Indonesia.
        Berikut atribusi, lisensi, dan perubahan yang dilakukan.
      </p>
      <ul class="w-richtext">
        {credits.map((credit) => (
          <li>
            <strong>{credit.title}</strong> — {credit.author}.
            {' '}<a href={credit.source} rel="noopener noreferrer" target="_blank">Sumber</a>.
            {credit.licenseUrl ? (
              <> Lisensi <a href={credit.licenseUrl} rel="noopener noreferrer" target="_blank">{credit.license}</a>.</>
            ) : (
              <> Lisensi {credit.license}.</>
            )}
            {' '}{credit.changes}
          </li>
        ))}
      </ul>
    </div>
  </div>
</ContentLayout>
