  },
  {
    title: 'Pendidikan Unggul',
    file: 'pendidikan-unggul.webp',
    author: 'Fitrah 9131',
    source: 'https://commons.wikimedia.org/wiki/File:The_atmosphere_of_a_junior_high_school_classroom_in_Indonesia.jpg',
