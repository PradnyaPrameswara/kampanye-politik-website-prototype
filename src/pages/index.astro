---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Headline from '@/components/sections/Headline.astro';
import SectionWrapper from '@/components/layout/SectionWrapper.astro';
import FaqAccordion from '@/components/react/FaqAccordion.tsx';
import VideoLightbox from '@/components/react/VideoLightbox.tsx';
import { getCollection } from 'astro:content';
import events from '@/data/events.json';

const allObjectives = await getCollection('objectives');

const orderedObjectiveSlugs = [
  'advancing-social-equity-and-justice',
  'protecting-human-rights-and-freedoms',
  'improving-healthcare-access-and-quality',
] as const;

const objectives = orderedObjectiveSlugs.flatMap((slug) => {
  const obj = allObjectives.find((o) => o.slug === slug);

  return obj ? [obj] : [];
});

const objectiveImages = {
  'advancing-social-equity-and-justice': '/images/assets/66de86499b602e1b2f5cfbc1_Objectives%20Image%206.jpg',
  'protecting-human-rights-and-freedoms': '/images/assets/66de8604cdbecf88f8bdcd34_Objectives%20Image%205.jpg',
  'improving-healthcare-access-and-quality': '/images/assets/66de85ebcdae96c41a0e5b3f_Objectives%20Image%204.jpg',
  'boosting-national-security-and-safety': '/images/assets/66de85c7f4911980aa633be9_Objectives%20Image%203.jpg',
  'ensuring-fair-legal-and-justice-systems': '/images/assets/66de859d80ec78184905d9b3_Objectives%20Image%202.jpg',
  'strengthening-economic-opportunity': '/images/assets/66de850f20911f1251f963e9_Objectives%20Image%201.jpg',
} as const;

const allTeamMembers = await getCollection('team');

const teamImages = {
  'john-smith': '/images/assets/66de885235a491ec7c9579d4_Team%20Image%206.webp',
  'sarah-johnson': '/images/assets/66de8849ae04b9432a83ed16_Team%20Image%205.webp',
  'michael-brown': '/images/assets/66de8840477d16d8930afdba_Team%20Image%204.webp',
  'david-wilson': '/images/assets/66de88373555ab75c632122c_Team%20Image%203.webp',
  'jessica-lee': '/images/assets/66de882ef48421d2f55b6983_Team%20Image%202.webp',
  'james-clark': '/images/assets/66de882483ff8257a260072a_Team%20Image%201.webp',
} as const;

// Preserve featured team member order: John Smith, Sarah Johnson, Michael Brown
const featuredTeamSlugs = ['john-smith', 'sarah-johnson', 'michael-brown'] as const;

const teamMembers = featuredTeamSlugs.flatMap((slug) => {
  const member = allTeamMembers.find((m) => m.id === slug);

  return member ? [member] : [];
});

const allPosts = await getCollection('blog');

const blogImages = {
  'understanding-recent-policy-changes': '/images/assets/66de845af00d0586abb5ff9f_Blog%20Image%206.jpg',
  'building-strong-advocacy-coalitions': '/images/assets/66de844253d3899d0b7ea2ae_Blog%20Image%205.jpg',
  'community-initiatives-making-a-difference': '/images/assets/66de84243555ab75c62dcfa4_Blog%20Image%204.jpg',
  'impact-of-policy-on-local-communities': '/images/assets/66de840153d3899d0b7e7164_Blog%20Image%203.jpg',
  'effective-advocacy-strategies-for-success': '/images/assets/66de83db9b602e1b2f5a8425_Blog%20Image%202.jpg',
  'stories-of-community-impact-and-change': '/images/assets/66de82a68945e61eaf28d812_Blog%20Image%201.jpg',
} as const;

// Preserve featured blog post order
const featuredBlogSlugs = [
  'understanding-recent-policy-changes',
  'building-strong-advocacy-coalitions',
] as const;

const blogPosts = featuredBlogSlugs.flatMap((slug) => {
  const post = allPosts.find((p) => p.slug === slug);

  return post ? [post] : [];
});

const faqItems = [
  { 
    question: 'What is the core vision of Asta Cita?', 
    answer: 'Asta Cita sets eight strategic missions to safeguard national sovereignty, guarantee food self-sufficiency, and achieve Indonesia Emas 2045.' 
  },
  { 
    question: 'How does Makan Bergizi Gratis work?', 
    answer: 'The program provides daily nutritious meals to schoolchildren and mothers to end stunting and support local agricultural supply chains.' 
  },
  { 
    question: 'How is food self-reliance achieved?', 
    answer: 'Indonesia modernizes agricultural infrastructure, expands farmland, and supports local farmers to eliminate reliance on basic food imports.' 
  },
  { 
    question: 'How are strategic resources managed?', 
    answer: 'Domestic processing of minerals, agriculture, and maritime commodities adds local economic value and accelerates industrial growth.' 
  },
  { 
    question: 'How can citizens follow progress?', 
    answer: 'Citizens can track implementation updates through unified digital governance portals and regional public communication centers.' 
  },
];
---

<BaseLayout 
  title="CivicUnity - Inspiring Change Together We Shape Our Nation" 
  description="Official overview of President Prabowo Subianto's national missions: food sovereignty, nutrition programs, and industrial progress."
  hideNav={true}
>
  <!-- Hero Section & Floating Category Header -->
  <div class="header-bg-wrapper">
    <div class="header-bg">
      <Navbar currentPath="/" />
      
      <div class="section-hero">
        <div class="padding-global">
          <div class="container-large">
            <div class="hero-component">
              <div class="hero-left-content-wrapper reveal-left">
                <div class="hero-left-content">
                  <div class="hero-left-top-content">
                    <div class="dot"></div>
                    <div>Together, We Build a Strong Nation</div>
                  </div>
                  <h1 class="heading-style-h1 text-color-white">Inspiring progress together we shape our nation.</h1>
                </div>
                <a class="button w-inline-block" href="/contact">
                  <div>Join us now</div>
                </a>
              </div>
              
              <div class="hero-right-content-wrapper reveal-right">
                <div class="hero-right-content">
                  <h5 class="heading-style-h5 text-color-white">Advancing our national vision toward 2045.</h5>
                  <div class="text-size-regular text-color-white-300">Delivering daily nutrition for youth, advancing energy independence, and expanding strategic national industry.</div>
                </div>
                <VideoLightbox
                  client:visible
                  thumbnailSrc="/images/shared/hero-video-thumb.jpg"
                  videoUrl="https://www.youtube.com/watch?v=EMcS_sUYeqU"
                  triggerLabel="Watch"
                />
              </div>
              
              <img 
                alt="Civic Leader" 
                class="hero-bg-image" 
                loading="eager" 
                src="/images/shared/hero-image-1.webp"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Floating Donation Category Card -->
    <div class="section-category">
      <div class="padding-global">
        <div class="container-large">
          <div class="category-component">
            <div class="category-left-content-wrapper">
              <h3 class="heading-style-h3 text-color-white">Contribute</h3>
              <div class="text-size-small text-color-white-200">Help us reach our goal</div>
            </div>
            <div class="category-collection-list-wrapper w-dyn-list">
              <div class="category-collection-list w-dyn-items" role="list">
                {[100, 50, 25, 10, 5].map((amount) => (
                  <div class="category-collection-list-item w-dyn-item" role="listitem">
                    <a class="category-card w-inline-block" href={`/donate/${amount}`}>
                      <div>${amount}</div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- About Section -->
  <div class="section-about">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="about-component">
            <div class="about-left-content-wrapper reveal-left">
              <div class="about-left-top-content-wrapper">
                <div class="headline">
                  <div class="dot"></div>
                  <div>About us</div>
                </div>
                <div class="about-left-top-content">
                  <h2 class="heading-style-h2">Learn about our commitment to national progress</h2>
                  <p class="text-size-regular">Guided by Asta Cita, we advance key structural programs to reduce poverty. Strategic priorities secure domestic food and energy self-reliance.</p>
                </div>
              </div>
              <div class="padding-bottom padding-large"></div>
              <div class="w-layout-grid about-grid">
                <div class="about-card">
                  <img alt="" loading="lazy" src="/icons/about-logo-4.svg"/>
                  <div class="about-card-content">
                    <h6 class="heading-style-h6">National Nutrition Agency (BGN)</h6>
                  </div>
                </div>
                <div class="about-card">
                  <img alt="" loading="lazy" src="/icons/about-logo-3.svg"/>
                  <div class="about-card-content">
                    <h6 class="heading-style-h6">Food & Energy Security Taskforce</h6>
                  </div>
                </div>
                <div class="about-card">
                  <img alt="" loading="lazy" src="/icons/about-logo-2.svg"/>
                  <div class="about-card-content">
                    <h6 class="heading-style-h6">Defense & Maritime Sovereignty</h6>
                  </div>
                </div>
                <div class="about-card">
                  <img alt="" loading="lazy" src="/icons/about-logo-4.svg"/>
                  <div class="about-card-content">
                    <h6 class="heading-style-h6">INA Digital Public Services</h6>
                  </div>
                </div>
              </div>
              <div class="padding-bottom padding-medium"></div>
              <a class="button w-inline-block" href="/about"><div>More about us</div></a>
            </div>
            <div class="about-image-wrapper is-about reveal-right">
              <img alt="About CivicUnity" class="about-image" loading="lazy" src="/images/shared/about-image.webp"/>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Objectives Section -->
  <div class="section-objective">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="objective-component">
            <div class="objective-top-content-wrapper reveal-down">
              <div class="objective-top-left-content-wrapper">
                <div class="headline"><div class="dot"></div><div>Our objectives</div></div>
                <h2 class="heading-style-h2">Guiding our nation with purposeful strategic objectives.</h2>
              </div>
              <p class="text-size-regular">From youth nutrition to resource self-reliance, our strategic objectives establish a clear path toward enduring national prosperity.</p>
            </div>
            <div class="objective-collection-list-wrapper w-dyn-list">
              <div class="objective-collection-list w-dyn-items" role="list">
                {objectives.slice(0, 3).map((obj) => (
                  <div class="objective-collection-item w-dyn-item" role="listitem">
                    <a class="objective-card w-inline-block reveal-up" href={`/objectives/${obj.slug}`}>
                      <div class="objective-image-wrapper">
                        <img alt={obj.data.title} class="objective-image" loading="lazy" src={objectiveImages[obj.slug as keyof typeof objectiveImages] || `/images/objectives/${obj.slug}.jpg`} />
                      </div>
                      <div class="objective-card-content-wrapper">
                        <h5 class="heading-style-h5">{obj.data.title}</h5>
                        <p class="text-size-regular">{obj.data.description}</p>
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Community Stats Section -->
  <div class="section-community">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="community-component reveal-up">
            <div class="community-card">
              <h2 class="heading-style-h2">82.9M+</h2>
              <div class="text-size-regular">Meals target</div>
            </div>
            <div class="community-card">
              <h2 class="heading-style-h2">3M</h2>
              <div class="text-size-regular">Homes target</div>
            </div>
            <div class="community-card">
              <h2 class="heading-style-h2">100%</h2>
              <div class="text-size-regular">Energy security</div>
            </div>
            <div class="community-card _2nd">
              <h2 class="heading-style-h2">26</h2>
              <div class="text-size-regular">Commodities</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Team Section -->
  <div class="section-team">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="team-component">
            <div class="team-top-content-wrapper reveal-down">
              <div class="team-top-left-content-wrapper">
                <div class="headline"><div class="dot"></div><div>Our team</div></div>
                <h2 class="heading-style-h2">Building a stronger nation together.</h2>
              </div>
              <div class="text-size-regular">Dedicated public leadership coordinating ministries and communities to advance national welfare, security, and shared progress.</div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="team-collection-list-wrapper w-dyn-list">
              <div class="team-collection-list w-dyn-items" role="list">
                {teamMembers.map((member) => (
                  <div class="team-collection-list-item w-dyn-item" role="listitem">
                    <a class="team-card w-inline-block reveal-up" href={`/member/${member.id}`}>
                      <div class="team-image-wrapper" style="background-image:url('/images/assets/66dc1336a0bd34b5411c0bb8_Team%20Bg%20Image.jpg')">
                        <img 
                          alt={member.data.name} 
                          class="team-image" 
                          loading="lazy" 
                          sizes="(max-width: 479px) 93vw, (max-width: 767px) 94vw, (max-width: 991px) 46vw, 30vw" 
                          src={teamImages[member.id as keyof typeof teamImages] || (member.data.image ? member.data.image.src : `/images/team/${member.id}.webp`)} 
                        />
                      </div>
                      <div class="team-card-content-wrapper">
                        <div class="team-card-content">
                          <h5 class="heading-style-h5 text-color-white">{member.data.name}</h5>
                          <img alt="" class="arrow" loading="lazy" src="/images/assets/66dc04d922177f0428b4cc55_Team%20Arrow.svg" />
                        </div>
                        <div class="text-size-regular text-color-white">{member.data.title}</div>
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Events Section -->
  <div class="section-event">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="event-component">
            <div class="event-top-content-wrapper reveal-down">
              <div class="event-top-left-content">
                <div class="headline"><div class="dot"></div><div>Our events</div></div>
                <h2 class="heading-style-h2">Explore key upcoming events for national impact.</h2>
              </div>
              <div class="event-top-right-content-wrapper">
                <div class="text-size-regular">Engage with public leaders and community partners driving national self-reliance and progress.</div>
              </div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="event-bottom-content-wrapper">
              {events.map((event, i) => {
                const eventImg = i === 1 
                  ? '/images/assets/66ead80bd0b2f867500887cb_Event%20Image%202.avif' 
                  : i === 2 
                    ? '/images/assets/66ead80b5be6571f08a1a5d7_Event%20Image%203.jpg'
                    : '/images/assets/66ead80b851d571cc8c25ed8_Event%20Image%201.jpg';
                return (
                  <div class="event-card reveal-scale">
                    <div class="event-image-wrapper">
                      <img alt={event.title} class="event-image" loading="lazy" sizes="100vw" src={eventImg} />
                    </div>
                    <div class="event-card-content-wrapper">
                      <div class="event-card-top-content">
                        <h5 class="heading-style-h5">{event.title}</h5>
                        <div class="text-size-regular">{event.description}</div>
                      </div>
                      <div class="event-card-bottom-content-wrapper">
                        <div class="event-card-bottom-content">
                          <img alt="" class="event-icon" loading="lazy" src="/images/assets/66ead5b74b00c6857ddf134d_11.png" />
                          <div class="text-size-small">{event.location}</div>
                        </div>
                        <div class="event-card-bottom-content">
                          <img alt="" class="event-icon" loading="lazy" src="/images/assets/66ead5b74b00c6857ddf131d_12.png" />
                          <div class="text-size-small">{event.date}</div>
                        </div>
                        <div class="event-card-bottom-content">
                          <img alt="" class="event-icon" loading="lazy" src="/images/assets/66ead5b74b00c6857ddf12d9_13.png" />
                          <div class="text-size-small">{event.time}</div>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="section-cta">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="cta-component reveal-scale">
            <div class="cta-content-wrapper">
              <h2 class="heading-style-h2">Take action for change.</h2>
              <a class="button w-inline-block" href="/contact"><div>Join us now</div></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <FaqAccordion client:visible items={faqItems} />

  <!-- Blog Section -->
  <div class="section-blog">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="blog-component">
            <div class="blog-left-content-wrapper reveal-left">
              <div class="blog-left-top-content-wrapper">
                <div class="headline _2nd"><div class="dot"></div><div>Policy updates</div></div>
                <div class="blog-left-top-content">
                  <h2 class="heading-style-h2 text-color-white">Explore our updates for national policy insights.</h2>
                  <div class="text-size-regular text-color-white-200">Read timely summaries on flagship initiatives, regional development, and economic self-reliance.</div>
                </div>
                <a class="button w-inline-block" href="/blog"><div>View more</div></a>
              </div>
            </div>
            <div class="blog-right-content-wrapper reveal-right">
              <div class="blog-collection-list-wrapper w-dyn-list">
                <div class="blog-collection-list w-dyn-items" role="list">
                  {blogPosts.map((post) => (
                    <div class="blog-collection-item w-dyn-item" role="listitem">
                      <div class="blog-card reveal-scale">
                        <div class="blog-image-wrapper">
                          <img 
                            alt={post.data.title} 
                            class="blog-image" 
                            loading="lazy" 
                            sizes="100vw" 
                            src={blogImages[post.slug as keyof typeof blogImages] || (post.data.image ? post.data.image.src : `/images/blog/${post.slug}.jpg`)} 
                          />
                        </div>
                        <div class="blog-card-content-wrapper">
                          <div class="text-size-small">{new Date(post.data.publishDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</div>
                          <a class="blog-text-link w-inline-block" href={`/post/${post.slug}`}>
                            <h5 class="heading-style-h5">{post.data.title}</h5>
                          </a>
                          <div class="blog-card-content">
                            <a class="blog-button w-inline-block" href={`/post/${post.slug}`}>
                              <div>Read More</div>
                              <img alt="" class="arrow" loading="lazy" src="/images/assets/66dc04d84a2c1e5e023ff6fd_Blog%20Arrow.svg" />
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Donation Mission Section -->
  <div class="section-donation">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="donation-component">
            <div class="donation-left-content-wrapper reveal-left">
              <div class="donation-left-top-content-wrapper">
                <div class="headline"><div class="dot"></div><div>Contribute us</div></div>
                <div class="donation-left-top-content">
                  <h2 class="heading-style-h2">Support our national mission with your participation today.</h2>
                  <p class="text-size-regular">Support public outreach, local nutrition distribution networks, and community development programs for self-reliance.</p>
                </div>
              </div>
              <div class="donation-collection-list-wrapper w-dyn-list">
                <div class="donation-collection-list w-dyn-items" role="list">
                  {[100, 50, 25, 10, 5].map((amount) => (
                    <div class="donation-collection-list-item w-dyn-item" role="listitem">
                      <a class="donation-card w-inline-block" href={`/donate/${amount}`}>
                        <div>${amount}</div>
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="donation-image-wrapper reveal-right">
              <img alt="Donation mission" class="donation-image" loading="lazy" src="/images/donations/donation-image.webp" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
