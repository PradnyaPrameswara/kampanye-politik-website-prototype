---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Headline from '@/components/sections/Headline.astro';
import SectionWrapper from '@/components/layout/SectionWrapper.astro';
import FaqAccordion from '@/components/react/FaqAccordion.tsx';
import VideoLightbox from '@/components/react/VideoLightbox.tsx';
import { getCollection } from 'astro:content';
import { entrySlug } from '@/lib/entry';
import events from '@/data/events.json';
import { faqItems, faqTitle, faqSubtitle } from '@/components/sections/faq';

const programLinks = [
  { slug: 'makan-bergizi-gratis', label: 'Makan Bergizi Gratis' },
  { slug: 'swasembada-pangan', label: 'Swasembada Pangan' },
  { slug: 'hilirisasi-industri', label: 'Hilirisasi Industri' },
  { slug: 'ketahanan-energi', label: 'Ketahanan Energi' },
  { slug: 'pendidikan-unggul', label: 'Pendidikan Unggul' },
  { slug: 'kesehatan-rakyat', label: 'Kesehatan Rakyat' },
] as const;

const allObjectives = await getCollection('objectives');

const orderedObjectiveSlugs = [
  'advancing-social-equity-and-justice',
  'protecting-human-rights-and-freedoms',
  'improving-healthcare-access-and-quality',
] as const;

const objectives = orderedObjectiveSlugs.flatMap((slug) => {
  const obj = allObjectives.find((o) => entrySlug(o) === slug);

  return obj ? [obj] : [];
});

const objectiveImages = {
  'advancing-social-equity-and-justice': '/images/assets/66de86499b602e1b2f5cfbc1_Objectives%20Image%206.jpg',
  'protecting-human-rights-and-freedoms': '/images/assets/66de8604cdbecf88f8bdcd34_Objectives%20Image%205.jpg',
  'improving-healthcare-access-and-quality': '/images/assets/66de85ebcdae96c41a0e5b3f_Objectives%20Image%204.jpg',
  'boosting-national-security-and-safety': '/images/assets/66de85c7f4911980aa633be9_Objectives%20Image%203.jpg',
  'ensuring-fair-legal-and-justice-systems': '/images/assets/66de859d80ec78184905d9b3_Objectives%20Image%202.jpg',
  'strengthening-economic-opportunity': '/images/assets/66de850f20911f1251f963e9_Objectives%20Image%201.jpg',
} as const;

const allTeamMembers = await getCollection('team');

const teamImages = {
  'john-smith': '/images/assets/66de885235a491ec7c9579d4_Team%20Image%206.webp',
  'sarah-johnson': '/images/assets/66de8849ae04b9432a83ed16_Team%20Image%205.webp',
  'michael-brown': '/images/assets/66de8840477d16d8930afdba_Team%20Image%204.webp',
  'david-wilson': '/images/assets/66de88373555ab75c632122c_Team%20Image%203.webp',
  'jessica-lee': '/images/assets/66de882ef48421d2f55b6983_Team%20Image%202.webp',
  'james-clark': '/images/assets/66de882483ff8257a260072a_Team%20Image%201.webp',
} as const;

const teamSrcsets = {
  'john-smith': '/images/assets/66de885235a491ec7c9579d4_Team%20Image%206-p-500.webp 500w, /images/assets/66de885235a491ec7c9579d4_Team%20Image%206-p-800.webp 800w, /images/assets/66de885235a491ec7c9579d4_Team%20Image%206-p-1080.webp 1080w, /images/assets/66de885235a491ec7c9579d4_Team%20Image%206.webp 1152w',
  'sarah-johnson': '/images/assets/66de8849ae04b9432a83ed16_Team%20Image%205-p-500.webp 500w, /images/assets/66de8849ae04b9432a83ed16_Team%20Image%205-p-800.webp 800w, /images/assets/66de8849ae04b9432a83ed16_Team%20Image%205-p-1080.webp 1080w, /images/assets/66de8849ae04b9432a83ed16_Team%20Image%205.webp 1152w',
  'michael-brown': '/images/assets/66de8840477d16d8930afdba_Team%20Image%204-p-500.webp 500w, /images/assets/66de8840477d16d8930afdba_Team%20Image%204-p-800.webp 800w, /images/assets/66de8840477d16d8930afdba_Team%20Image%204-p-1080.webp 1080w, /images/assets/66de8840477d16d8930afdba_Team%20Image%204.webp 1152w',
} as const;

const featuredTeamSlugs = ['john-smith', 'sarah-johnson', 'michael-brown'] as const;

const teamMembers = featuredTeamSlugs.flatMap((slug) => {
  const member = allTeamMembers.find((m) => entrySlug(m) === slug);

  return member ? [member] : [];
});

const allPosts = await getCollection('blog');

const blogImages = {
  'understanding-recent-policy-changes': '/images/assets/66de845af00d0586abb5ff9f_Blog%20Image%206.jpg',
  'building-strong-advocacy-coalitions': '/images/assets/66de844253d3899d0b7ea2ae_Blog%20Image%205.jpg',
  'community-initiatives-making-a-difference': '/images/assets/66de84243555ab75c62dcfa4_Blog%20Image%204.jpg',
  'impact-of-policy-on-local-communities': '/images/assets/66de840153d3899d0b7e7164_Blog%20Image%203.jpg',
  'effective-advocacy-strategies-for-success': '/images/assets/66de83db9b602e1b2f5a8425_Blog%20Image%202.jpg',
  'stories-of-community-impact-and-change': '/images/assets/66de82a68945e61eaf28d812_Blog%20Image%201.jpg',
} as const;

// Preserve featured blog post order
const featuredBlogSlugs = [
  'understanding-recent-policy-changes',
  'building-strong-advocacy-coalitions',
] as const;

const blogPosts = featuredBlogSlugs.flatMap((slug) => {
  const post = allPosts.find((p) => entrySlug(p) === slug);

  return post ? [post] : [];
});

---

<BaseLayout 
  title="Kabinet Merah Putih — Menuju Indonesia Emas 2045" 
  description="Portal resmi informasi program prioritas Asta Cita Kabinet Merah Putih di bawah kepemimpinan Presiden Republik Indonesia Prabowo Subianto." 
  hideNav={true} 
  currentPath="/"
>
  <!-- Hero Section & Floating Category Header -->
  <div class="header-bg-wrapper">
    <div class="header-bg">
      <Navbar currentPath="/" />
      
      <div class="section-hero">
        <div class="padding-global">
          <div class="container-large">
            <div class="hero-component">
              <div class="hero-left-content-wrapper reveal-left">
                <div class="hero-left-content">
                  <div class="hero-left-top-content">
                    <div class="dot"></div>
                    <div>Asta Cita: Menuju Indonesia Emas 2045</div>
                  </div>
                  <h1 class="heading-style-h1 text-color-white">Bersatu Membangun<br />Bangsa Berdaulat<br />&amp; Mandiri.</h1>
                </div>
                <a class="button w-inline-block" href="/objective">
                  <div>Program Prioritas</div>
                </a>
              </div>
              
              <img
                alt="Presiden Republik Indonesia Prabowo Subianto"
                class="hero-bg-image"
                loading="eager"
                src="/images/shared/hero-image-prabowo.webp"
              />

              <div class="hero-right-content-wrapper reveal-right">
                <div class="hero-right-content">
                  <h5 class="heading-style-h5 text-color-white">Asta Cita &amp; Kedaulatan Nasional.</h5>
                  <div class="text-size-regular text-color-white-300">Swasembada pangan dan energi, makan bergizi gratis bagi pemuda, hilirisasi 26 komoditas strategis, serta pemantapan pertahanan semesta.</div>
                </div>
                <VideoLightbox
                  client:visible
                  thumbnailSrc="/images/shared/hero-video-thumb.jpg"
                  videoUrl="https://www.youtube.com/watch?v=EMcS_sUYeqU"
                  triggerLabel="Saksikan"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Floating Donation Category Card -->
    <div class="section-category">
      <div class="padding-global">
        <div class="container-large">
          <div class="category-component">
            <div class="category-left-content-wrapper">
              <h3 class="heading-style-h3 text-color-white">Partisipasi</h3>
              <div class="text-size-small text-color-white-200">Gotong royong untuk kemakmuran bersama</div>
            </div>
            <div class="category-collection-list-wrapper w-dyn-list">
              <div class="category-collection-list w-dyn-items" role="list">
                {programLinks.map((program) => (
                  <div class="category-collection-list-item w-dyn-item" role="listitem">
                    <a class="category-card w-inline-block" href={`/program/${program.slug}`}>
                      <div>{program.label}</div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- About Section -->
  <div class="section-about">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="about-component">
            <div class="about-left-content-wrapper reveal-left">
              <div class="about-left-top-content-wrapper">
                <div class="headline">
                  <div class="dot"></div>
                  <div>Tentang Kabinet</div>
                </div>
                <div class="about-left-top-content">
                  <h2 class="heading-style-h2">Komitmen Nyata Demi Kedaulatan &amp; Kemakmuran Rakyat</h2>
                  <p class="text-size-regular">Berlandaskan 8 Misi Asta Cita, Kabinet Merah Putih mengonsolidasikan seluruh kekuatan kementerian dan lembaga negara demi tercapainya kedaulatan pangan, kemandirian energi, dan keadilan sosial bagi seluruh rakyat Indonesia.</p>
                </div>
              </div>
              <div class="padding-bottom padding-large"></div>
              <div class="w-layout-grid about-grid">
                <div class="about-card">
                  <img alt="Badan Gizi Nasional" class="size-8 object-contain" loading="lazy" src="/images/ministries/bgn.svg"/>
                  <div class="about-card-content">
                    <h6 class="heading-style-h6">Badan Gizi Nasional (BGN)</h6>
                  </div>
                </div>
                <div class="about-card">
                  <img alt="Kementerian Pertanian" class="size-8 object-contain" loading="lazy" src="/images/ministries/kementan.svg"/>
                  <div class="about-card-content">
                    <h6 class="heading-style-h6">Kementerian Pertanian RI</h6>
                  </div>
                </div>
                <div class="about-card">
                  <img alt="Kementerian Pertahanan" class="size-8 object-contain" loading="lazy" src="/images/ministries/kemhan.svg"/>
                  <div class="about-card-content">
                    <h6 class="heading-style-h6">Kementerian Pertahanan RI</h6>
                  </div>
                </div>
                <div class="about-card">
                  <img alt="Kementerian Komunikasi dan Digital" class="size-8 object-contain" loading="lazy" src="/images/ministries/komdigi.svg"/>
                  <div class="about-card-content">
                    <h6 class="heading-style-h6">Kementerian Komunikasi &amp; Digital</h6>
                  </div>
                </div>
              </div>
              <div class="padding-bottom padding-medium"></div>
              <a class="button w-inline-block" href="/about"><div>Selengkapnya</div></a>
            </div>
            <div class="about-image-wrapper is-about reveal-right">
              <img alt="Bhinneka Tunggal Ika - Garuda Pancasila" class="about-image" loading="lazy" src="/images/shared/about-image.webp"/>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Objectives Section -->
  <div class="section-objective">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="objective-component">
            <div class="objective-top-content-wrapper reveal-down">
              <div class="objective-top-left-content-wrapper">
                <div class="headline"><div class="dot"></div><div>Misi Strategis</div></div>
                <h2 class="heading-style-h2">Mengarahkan Bangsa melalui Misi Strategis yang Berdampak.</h2>
              </div>
              <p class="text-size-regular">Dari gizi generasi muda hingga kemandirian sumber daya, misi strategis kami menetapkan jalan yang jelas menuju kemakmuran nasional yang berkelanjutan.</p>
            </div>
            <div class="objective-collection-list-wrapper w-dyn-list">
              <div class="objective-collection-list w-dyn-items" role="list">
                {objectives.slice(0, 3).map((obj) => (
                  <div class="objective-collection-item w-dyn-item" role="listitem">
                    <a class="objective-card w-inline-block reveal-up" href={`/objectives/${entrySlug(obj)}`}>
                      <div class="objective-image-wrapper">
                        <img alt={obj.data.title} class="objective-image" loading="lazy" src={objectiveImages[entrySlug(obj) as keyof typeof objectiveImages] || `/images/objectives/${entrySlug(obj)}.jpg`} />
                      </div>
                      <div class="objective-card-content-wrapper">
                        <h5 class="heading-style-h5">{obj.data.title}</h5>
                        <p class="text-size-regular">{obj.data.description}</p>
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Community Stats Section -->
  <div class="section-community">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="community-component reveal-up">
            <div class="community-card">
              <h2 class="heading-style-h2">82,9 Jt+</h2>
              <div class="text-size-regular">Target Penerima Makan Bergizi</div>
            </div>
            <div class="community-card">
              <h2 class="heading-style-h2">3 Jt</h2>
              <div class="text-size-regular">Target Rumah</div>
            </div>
            <div class="community-card">
              <h2 class="heading-style-h2">100%</h2>
              <div class="text-size-regular">Ketahanan Energi</div>
            </div>
            <div class="community-card _2nd">
              <h2 class="heading-style-h2">26</h2>
              <div class="text-size-regular">Komoditas Strategis</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Team Section -->
  <div class="section-team">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="team-component">
            <div class="team-top-content-wrapper reveal-down">
              <div class="team-top-left-content-wrapper">
                <div class="headline"><div class="dot"></div><div>Program Prioritas</div></div>
                <h2 class="heading-style-h2">Sinergi Lembaga Menuju Indonesia Emas 2045.</h2>
              </div>
              <div class="text-size-regular">Sinergi kementerian dan lembaga negara di bawah kepemimpinan Presiden Prabowo Subianto dalam mengawal agenda Asta Cita demi kemakmuran rakyat.</div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="team-collection-list-wrapper w-dyn-list">
              <div class="team-collection-list w-dyn-items" role="list">
                {teamMembers.map((member) => (
                  <div class="team-collection-list-item w-dyn-item" role="listitem">
                    <a class="team-card w-inline-block reveal-up" href={`/member/${entrySlug(member)}`}>
                      <div class="team-image-wrapper" style="background-image:url('/images/assets/66dc1336a0bd34b5411c0bb8_Team%20Bg%20Image.jpg')">
                        <img 
                          alt={member.data.name} 
                          class="team-image" 
                          loading="lazy" 
                          sizes="(max-width: 479px) 93vw, (max-width: 767px) 94vw, (max-width: 991px) 46vw, 384px" 
                          src={teamImages[entrySlug(member) as keyof typeof teamImages] || (member.data.image ? member.data.image.src : `/images/team/${entrySlug(member)}.webp`)}
                          srcset={teamSrcsets[entrySlug(member) as keyof typeof teamSrcsets]}
                        />
                      </div>
                      <div class="team-card-content-wrapper">
                        <div class="team-card-content">
                          <h5 class="heading-style-h5 text-color-white">{member.data.name}</h5>
                          <img alt="" class="arrow" loading="lazy" src="/images/assets/66dc04d922177f0428b4cc55_Team%20Arrow.svg" />
                        </div>
                        <div class="text-size-regular text-color-white">{member.data.title}</div>
                      </div>
                    </a>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Events Section -->
  <div class="section-event">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="event-component">
            <div class="event-top-content-wrapper reveal-down">
              <div class="event-top-left-content">
                <div class="headline"><div class="dot"></div><div>Agenda Nasional</div></div>
                <h2 class="heading-style-h2">Agenda &amp; Musyawarah Kerja Nasional.</h2>
              </div>
              <div class="event-top-right-content-wrapper">
                <div class="text-size-regular">Rangkaian agenda konsolidasi kementerian, lembaga, dan perwakilan masyarakat dalam pengawalan program strategis nasional.</div>
              </div>
            </div>
            <div class="padding-bottom padding-large"></div>
            <div class="event-bottom-content-wrapper">
              {events.map((event, i) => {
                const eventImg = i === 1 
                  ? '/images/assets/66ead80bd0b2f867500887cb_Event%20Image%202.avif' 
                  : i === 2 
                    ? '/images/assets/66ead80b5be6571f08a1a5d7_Event%20Image%203.jpg'
                    : '/images/assets/66ead80b851d571cc8c25ed8_Event%20Image%201.jpg';
                const eventSrcset = i === 1
                  ? '/images/assets/66ead80bd0b2f867500887cb_Event%20Image%202-p-500.avif 500w, /images/assets/66ead80bd0b2f867500887cb_Event%20Image%202.avif 1152w'
                  : i === 2
                    ? '/images/assets/66ead80b5be6571f08a1a5d7_Event%20Image%203-p-500.jpg 500w, /images/assets/66ead80b5be6571f08a1a5d7_Event%20Image%203-p-800.jpg 800w, /images/assets/66ead80b5be6571f08a1a5d7_Event%20Image%203-p-1080.jpg 1080w, /images/assets/66ead80b5be6571f08a1a5d7_Event%20Image%203.jpg 1152w'
                    : '/images/assets/66ead80b851d571cc8c25ed8_Event%20Image%201-p-500.jpg 500w, /images/assets/66ead80b851d571cc8c25ed8_Event%20Image%201-p-800.jpg 800w, /images/assets/66ead80b851d571cc8c25ed8_Event%20Image%201-p-1080.jpg 1080w, /images/assets/66ead80b851d571cc8c25ed8_Event%20Image%201.jpg 1152w';
                return (
                  <div class="event-card reveal-scale">
                    <div class="event-image-wrapper">
                      <img alt={event.title} class="event-image" loading="lazy" sizes="100vw" src={eventImg} srcset={eventSrcset} />
                    </div>
                    <div class="event-card-content-wrapper">
                      <div class="event-card-top-content">
                        <h5 class="heading-style-h5">{event.title}</h5>
                        <div class="text-size-regular">{event.description}</div>
                      </div>
                      <div class="event-card-bottom-content-wrapper">
                        <div class="event-card-bottom-content">
                          <img alt="" class="event-icon" loading="lazy" src="/images/assets/66ead5b74b00c6857ddf134d_11.png" />
                          <div class="text-size-small">{event.location}</div>
                        </div>
                        <div class="event-card-bottom-content">
                          <img alt="" class="event-icon" loading="lazy" src="/images/assets/66ead5b74b00c6857ddf131d_12.png" />
                          <div class="text-size-small">{event.date}</div>
                        </div>
                        <div class="event-card-bottom-content">
                          <img alt="" class="event-icon" loading="lazy" src="/images/assets/66ead5b74b00c6857ddf12d9_13.png" />
                          <div class="text-size-small">{event.time}</div>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="section-cta">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="cta-component reveal-scale">
            <div class="cta-content-wrapper">
              <h2 class="heading-style-h2">Bersatu Untuk<br />Indonesia Maju.</h2>
              <a class="button w-inline-block" href="/objective"><div>Jelajahi Program</div></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Donation Mission Section -->
  <div class="section-donation">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="donation-component">
            <div class="donation-left-content-wrapper reveal-left">
              <div class="donation-left-top-content-wrapper">
                <div class="headline"><div class="dot"></div><div>Partisipasi Publik</div></div>
                <div class="donation-left-top-content">
                  <h2 class="heading-style-h2">Gotong Royong Kebangsaan Mengawal Asta Cita.</h2>
                  <p class="text-size-regular">Dukungan partisipasi publik memperkuat keterlibatan masyarakat dalam pengawasan dan pendampingan program Makan Bergizi Gratis serta swasembada pangan di daerah.</p>
                </div>
              </div>
              <div class="donation-collection-list-wrapper w-dyn-list">
                <div class="donation-collection-list w-dyn-items" role="list">
                  {programLinks.map((program) => (
                    <div class="donation-collection-list-item w-dyn-item" role="listitem">
                      <a class="donation-card w-inline-block" href={`/program/${program.slug}`}>
                        <div>{program.label}</div>
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div class="donation-image-wrapper reveal-right">
              <img alt="Partisipasi Publik dalam Program Strategis Nasional" class="donation-image" loading="lazy" src="/images/donations/donation-image.webp" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <!-- FAQ Section -->
  <FaqAccordion client:visible items={faqItems} title={faqTitle} subtitle={faqSubtitle} />

  <!-- Blog Section -->
  <div class="section-blog">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium">
          <div class="blog-component">
            <div class="blog-left-content-wrapper reveal-left">
              <div class="blog-left-top-content-wrapper">
                <div class="headline _2nd"><div class="dot"></div><div>Warta Kebijakan</div></div>
                <div class="blog-left-top-content">
                  <h2 class="heading-style-h2 text-color-white">Warta &amp; Informasi Strategis Kabinet.</h2>
                  <div class="text-size-regular text-color-white-200">Kilas informasi terkini pelaksanaan Asta Cita, pembangunan daerah, dan capaian kemandirian nasional.</div>
                </div>
                <a class="button w-inline-block" href="/blog"><div>Lihat Warta</div></a>
              </div>
            </div>
            <div class="blog-right-content-wrapper reveal-right">
              <div class="blog-collection-list-wrapper w-dyn-list">
                <div class="blog-collection-list w-dyn-items" role="list">
                  {blogPosts.map((post) => (
                    <div class="blog-collection-item w-dyn-item" role="listitem">
                      <div class="blog-card reveal-scale">
                        <div class="blog-image-wrapper">
                          <img 
                            alt={post.data.title} 
                            class="blog-image" 
                            loading="lazy" 
                            sizes="100vw" 
                            src={blogImages[entrySlug(post) as keyof typeof blogImages] || (post.data.image ? post.data.image.src : `/images/blog/${entrySlug(post)}.jpg`)} 
                          />
                        </div>
                        <div class="blog-card-content-wrapper">
                          <div class="text-size-small">{new Date(post.data.publishDate).toLocaleDateString('id-ID', { month: 'long', day: 'numeric', year: 'numeric' })}</div>
                          <a class="blog-text-link w-inline-block" href={`/post/${entrySlug(post)}`}>
                            <h5 class="heading-style-h5">{post.data.title}</h5>
                          </a>
                          <div class="blog-card-content">
                            <a class="blog-button w-inline-block" href={`/post/${entrySlug(post)}`}>
                              <div>Baca Selengkapnya</div>
                              <img alt="" class="arrow" loading="lazy" src="/images/assets/66dc04d84a2c1e5e023ff6fd_Blog%20Arrow.svg" />
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</BaseLayout>
