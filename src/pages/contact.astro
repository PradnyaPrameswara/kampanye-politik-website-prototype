---
import ContentLayout from '@/layouts/ContentLayout.astro';
import ContactForm from '@/components/react/ContactForm';
import FaqAccordion from '@/components/react/FaqAccordion';
---

<ContentLayout 
  title="Asta Cita - Contact & Inquiries | President Prabowo Subianto Flagship Programs" 
  bannerTitle="Contact & Inquiries" 
  bannerImage="/images/webflow/66dc04da6ea52df0b922ccc8_Contact%20Bg%20Image.webp"
  bannerSrcset="/images/webflow/66dc04da6ea52df0b922ccc8_Contact%20Bg%20Image-p-500.webp 500w, /images/webflow/66dc04da6ea52df0b922ccc8_Contact%20Bg%20Image-p-800.webp 800w, /images/webflow/66dc04da6ea52df0b922ccc8_Contact%20Bg%20Image-p-1080.webp 1080w, /images/webflow/66dc04da6ea52df0b922ccc8_Contact%20Bg%20Image.webp 1440w"
  bannerClass="_2nd"
  currentPath="/contact"
>
  <!-- Section Contact -->
  <div class="section-contact">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-medium is-header">
          <div class="container-component">
            <div class="contact-left-content-wrapper reveal-left">
              <div class="contact-left-top-content">
                <h2 class="heading-style-h2">Submit an inquiry or connect with national program coordinators</h2>
              </div>
              <ContactForm client:visible />
            </div>
            <div class="contact-right-image-wrapper reveal-right">
              <img 
                alt="" 
                class="contact-right-image" 
                loading="lazy" 
                sizes="(max-width: 479px) 93vw, (max-width: 991px) 94vw, 344px" 
                src="/images/webflow/66dc04dc3c0dbe656ece1d9c_Contact%20Image.webp" 
                srcset="/images/webflow/66dc04dc3c0dbe656ece1d9c_Contact%20Image-p-500.webp 500w, /images/webflow/66dc04dc3c0dbe656ece1d9c_Contact%20Image-p-800.webp 800w, /images/webflow/66dc04dc3c0dbe656ece1d9c_Contact%20Image-p-1080.webp 1080w, /images/webflow/66dc04dc3c0dbe656ece1d9c_Contact%20Image.webp 1164w"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section FAQ -->
  <FaqAccordion client:visible />
</ContentLayout>
