---
import BaseLayout from './BaseLayout.astro';
import Navbar from '@/components/layout/Navbar.astro';

interface Props {
  title: string;
  description?: string;
  bannerTitle: string;
  bannerImage?: string;
}

const { title, description, bannerTitle, bannerImage = '/images/shared/banner-about.webp' } = Astro.props;
---

<BaseLayout title={title} description={description} hideNav={true}>
  <div class="banner-wrapper">
    <Navbar />
    <div class="banner">
      <div class="banner-content-wrapper">
        <div class="banner-content">
          <div class="banner-dot"></div>
          <h1 class="heading-style-h1 text-color-white">{bannerTitle}</h1>
        </div>
      </div>
      <div class="banner-overly"></div>
      <div class="banner-image-wrapper">
        <img alt="" class="banner-image" loading="lazy" src={bannerImage} />
      </div>
    </div>
  </div>
  <div class="content-wrapper">
    <slot />
  </div>
</BaseLayout>
