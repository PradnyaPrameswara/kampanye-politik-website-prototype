---
import type { HTMLAttributes } from 'astro/types';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';

interface Props extends HTMLAttributes<'button'>, HTMLAttributes<'a'> {
  href?: string;
  variant?: 'default' | 'primary' | 'secondary' | 'outline' | 'ghost' | 'link';
  size?: 'default' | 'sm' | 'lg' | 'icon';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  href,
  variant = 'primary',
  size = 'default',
  class: className = '',
  type = 'button',
  ...rest
} = Astro.props;

const combinedClass = cn(buttonVariants({ variant: variant === 'primary' ? 'primary' : variant, size }), className);
---

{
  href ? (
    <a href={href} class={combinedClass} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={combinedClass} {...rest}>
      <slot />
    </button>
  )
}
