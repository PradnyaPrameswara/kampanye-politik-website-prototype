---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'>, HTMLAttributes<'a'> {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const {
  href,
  variant = 'primary',
  class: className = '',
  type = 'button',
  ...rest
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded-[0.75rem] px-6 py-[0.8125rem] text-base transition-colors duration-200 cursor-pointer';

const variants = {
  primary: 'bg-brand-blue hover:bg-brand-red text-neutral-white',
  secondary: 'bg-brand-red hover:bg-neutral-black-500 text-neutral-white',
  outline: 'border border-neutral-white-300 text-neutral-black-900 hover:bg-neutral-white-200',
};

const combinedClass = `${baseStyles} ${variants[variant] || variants.primary} ${className}`;
---

{
  href ? (
    <a href={href} class={combinedClass} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={combinedClass} {...rest}>
      <slot />
    </button>
  )
}
