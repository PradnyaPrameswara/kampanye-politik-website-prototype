---
import NewsletterForm from '../react/NewsletterForm';
---

<div class="section-footer">
  <div class="padding-global">
    <div class="container-large">
      <div class="footer-component">
        <div class="w-layout-grid footer-grid">
          <div class="footer-left-content-wrapper">
            <div class="footer-left-top-content">
              <a aria-current="page" class="footer-brand-logo-wrapper w-inline-block w--current" href="/">
                <img alt="CivicUnity Logo" class="footer-logo" loading="lazy" src="/images/nav-logo.svg" />
              </a>
              <div class="text-size-regular text-color-white-200">
                United under Asta Cita: driving national food sovereignty, children's nutrition, industrial downstreaming, and Indonesia Emas 2045.
              </div>
            </div>
            <div class="padding-bottom padding-medium"></div>
            <div class="footer-form-block w-form">
              <NewsletterForm client:visible />
            </div>
            <div class="padding-bottom padding-medium"></div>
            <div class="footer-social-link-wrapper">
              <a class="footer-social-link w-inline-block" href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <img alt="Instagram" class="social-icon" loading="lazy" src="/icons/social-instagram.svg" />
              </a>
              <a class="footer-social-link w-inline-block" href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                <img alt="Twitter" class="social-icon" loading="lazy" src="/icons/social-twitter.svg" />
              </a>
              <a class="footer-social-link w-inline-block" href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <img alt="Facebook" class="social-icon" loading="lazy" src="/icons/social-facebook.svg" />
              </a>
            </div>
          </div>
          <div class="footer-link-list-wrapper">
            <div class="footer-content">
              <h6 class="heading-style-h6 text-color-white-200">Pages</h6>
            </div>
            <div class="footer-link-list">
              <a class="footer-link" href="/">Home</a>
              <a class="footer-link" href="/about">About</a>
              <a class="footer-link" href="/contact">Contact</a>
            </div>
          </div>
          <div class="footer-link-list-wrapper">
            <div class="footer-content">
              <h6 class="heading-style-h6 text-color-white-200">Inner page</h6>
            </div>
            <div class="footer-link-list">
              <a class="footer-link" href="/objective">Objectives</a>
              <a class="footer-link" href="/team">Team</a>
              <a class="footer-link" href="/blog">Blog</a>
            </div>
          </div>
          <div class="footer-link-list-wrapper">
            <div class="footer-content">
              <h6 class="heading-style-h6 text-color-white-200">Campaign</h6>
            </div>
            <div class="footer-link-list">
              <a class="footer-link" href="/donate">Donate details</a>
              <a class="footer-link" href="/objectives/advancing-social-equity-and-justice">Objective details</a>
              <a class="footer-link" href="/team/john-smith">Team details</a>
              <a class="footer-link" href="/blog/understanding-recent-policy-changes">Blog details</a>
            </div>
          </div>
          <div class="footer-link-list-wrapper">
            <div class="footer-content">
              <h6 class="heading-style-h6 text-color-white-200">Utility page</h6>
            </div>
            <div class="footer-link-list">
              <a class="footer-link" href="/style-guide">Style guide</a>
              <a class="footer-link" href="/license">Licenses</a>
              <a class="footer-link" href="/404">404 not found</a>
              <a class="footer-link" href="/change-log">Change log</a>
            </div>
          </div>
        </div>
        <div class="padding-bottom padding-small"></div>
        <div class="footer-bottom-content-wrapper">
          <div class="text-size-small text-color-white-300">
            Powered by Astro | CivicUnity Indonesia
          </div>
          <div class="text-size-regular">
            <a class="footer-link _2nd" href="#">Privacy Policy</a> | <a class="footer-link _2nd" href="#">Terms of Service</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
