---
import NewsletterForm from '../react/NewsletterForm';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const toHref = (path: string) => path === '/' ? (base ? `${base}/` : '/') : `${base}${path}`;
---

<div class="section-footer">
  <div class="padding-global">
    <div class="container-large">
      <div class="footer-component">
        <div class="w-layout-grid footer-grid">
          <div class="footer-left-content-wrapper">
            <div class="footer-left-top-content">
              <a aria-current="page" class="footer-brand-logo-wrapper w-inline-block w--current" href={toHref('/')}>
                <img alt="Kabinet Merah Putih" class="footer-logo" loading="lazy" src="/images/nav-logo.svg" />
              </a>
              <div class="text-size-regular text-color-white-200">
                Asta Cita: Bersatu membangun kedaulatan, ketahanan pangan, dan kemakmuran rakyat Indonesia.
              </div>
            </div>
            <div class="padding-bottom padding-medium"></div>
            <div class="footer-form-block w-form">
              <NewsletterForm client:visible />
            </div>
            <div class="padding-bottom padding-medium"></div>
            <div class="footer-social-link-wrapper">
              <a class="footer-social-link w-inline-block" href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <img alt="Instagram" class="social-icon" loading="lazy" src="/icons/social-instagram.svg" />
              </a>
              <a class="footer-social-link w-inline-block" href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                <img alt="Twitter" class="social-icon" loading="lazy" src="/icons/social-twitter.svg" />
              </a>
              <a class="footer-social-link w-inline-block" href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                <img alt="LinkedIn" class="social-icon" loading="lazy" src="/images/assets/66dc04d82f0c3749635de0f6_Linkedin%20Icon.svg" />
              </a>
              <a class="footer-social-link w-inline-block" href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <img alt="Facebook" class="social-icon" loading="lazy" src="/icons/social-facebook.svg" />
              </a>
            </div>
          </div>
          <div class="footer-link-list-wrapper">
            <div class="footer-content">
              <h3 class="heading-style-h6 text-color-white-200">Halaman</h3>
            </div>
            <div class="footer-link-list">
              <a class="footer-link" href={toHref('/')}>Beranda</a>
              <a class="footer-link" href={toHref('/about')}>Tentang Kami</a>
              <a class="footer-link" href={toHref('/contact')}>Hubungi Kami</a>
            </div>
          </div>
          <div class="footer-link-list-wrapper">
            <div class="footer-content">
              <h3 class="heading-style-h6 text-color-white-200">Jelajahi</h3>
            </div>
            <div class="footer-link-list">
              <a class="footer-link" href={toHref('/objective')}>Tujuan</a>
              <a class="footer-link" href={toHref('/team')}>Tim</a>
              <a class="footer-link" href={toHref('/blog')}>Berita</a>
            </div>
          </div>
          <div class="footer-link-list-wrapper">
            <div class="footer-content">
              <h3 class="heading-style-h6 text-color-white-200">Detail Halaman</h3>
            </div>
            <div class="footer-link-list">
              <a class="footer-link" href={toHref('/program')}>Program Nasional</a>
              <a class="footer-link" href={toHref('/objectives/advancing-social-equity-and-justice')}>Detail Tujuan</a>
              <a class="footer-link" href={toHref('/member/john-smith')}>Detail Tim</a>
              <a class="footer-link" href={toHref('/post/understanding-recent-policy-changes')}>Detail Berita</a>
            </div>
          </div>
        </div>
        <div class="padding-bottom padding-small"></div>
        <div class="footer-bottom-content-wrapper">
          <div class="text-size-small text-color-white-300">
            Kabinet Merah Putih — Republik Indonesia
          </div>
          <div class="text-size-small text-color-white-300">
            <a class="footer-link _2nd" href={toHref('/kredit')}>Kredit Gambar</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
