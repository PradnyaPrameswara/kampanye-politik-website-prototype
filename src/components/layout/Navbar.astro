---
import { LayoutGrid } from 'lucide-react';
import MobileNavMenu from '../react/MobileNavMenu';

interface Props {
  currentPath?: string;
}

const rawPath = Astro.props.currentPath || Astro.url.pathname;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pathWithoutBase = base && rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath;

const cleanPath = pathWithoutBase.replace(/\/+$/, '') || '/';

const toHref = (path: string) => path === '/' ? (base ? `${base}/` : '/') : `${base}${path}`;

const navLinks = [
  { name: 'Beranda', path: '/' },
  { name: 'Tentang Kami', path: '/about' },
  { name: 'Hubungi Kami', path: '/contact' },
  { name: 'Tim', path: '/team' },
  { name: 'Berita', path: '/blog' },
];

const getActiveKey = (p: string): string => {
  if (p === '/') {
    return 'Beranda';
  }

  if (p === '/about' || p.startsWith('/about/')) {
    return 'Tentang Kami';
  }

  if (p === '/contact' || p.startsWith('/contact/')) {
    return 'Hubungi Kami';
  }

  if (p === '/team' || p.startsWith('/team/') || p.startsWith('/member/')) {
    return 'Tim';
  }

  if (p === '/blog' || p.startsWith('/blog/') || p.startsWith('/post/')) {
    return 'Berita';
  }

  if (p === '/program' || p.startsWith('/program/')) {
    return 'Program Nasional';
  }

  return '';
};

const activeKey = getActiveKey(cleanPath);
---

<div class="navbar w-nav" data-collapse="medium" role="banner">
  <div class="nav-container">
    <a aria-current={activeKey === 'Beranda' ? 'page' : undefined} class={`brand-logo-wrapper w-nav-brand ${activeKey === 'Beranda' ? 'w--current' : ''}`} href={toHref('/')}>
      <img alt="Kabinet Merah Putih" class="brand-logo" loading="lazy" src="/images/nav-logo.svg" />
    </a>
    <nav class="nav-menu w-nav-menu" role="navigation">
      {navLinks.map((link) => {
        const isActive = link.name === activeKey;
        return (
          <a 
            aria-current={isActive ? 'page' : undefined}
            class={`nav-link w-nav-link ${isActive ? 'w--current' : ''}`} 
            href={toHref(link.path)}
          >
            {link.name}
          </a>
        );
      })}
      <div class="nav-bottom-content hide-dekstop">
        <a aria-current={activeKey === 'Program Nasional' ? 'page' : undefined} class={`button w-inline-block ${activeKey === 'Program Nasional' ? 'w--current' : ''}`.trim()} href={toHref('/program')}><div>Jelajahi Program</div></a>
      </div>
    </nav>
    <div class="nav-left-content">
      <a class="w-commerce-commercecartopenlink nav-cart-button flex items-center" href={toHref('/program')} aria-label="Program Nasional" aria-current={activeKey === 'Program Nasional' ? 'page' : undefined}>
        <LayoutGrid className="w-commerce-commercecartopenlinkicon" size={17} strokeWidth={1.5} aria-hidden="true" />
        <div class="text-block w-inline-block">Program Nasional</div>
      </a>
      <div class="nav-bottom-content hide-tablet">
        <a aria-current={activeKey === 'Program Nasional' ? 'page' : undefined} class={`button w-inline-block ${activeKey === 'Program Nasional' ? 'w--current' : ''}`.trim()} href={toHref('/program')}><div>Jelajahi Program</div></a>
      </div>
      <div class="laptop:hidden flex items-center">
        <MobileNavMenu client:media="(max-width: 991px)" currentPath={cleanPath} />
      </div>
    </div>
  </div>
</div>
