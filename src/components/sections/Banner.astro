---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description,
  image = '/images/shared/hero-image-1.svg',
} = Astro.props;
---

<header class="banner-wrapper relative w-full h-[280px] tablet:h-[360px] laptop:h-[420px] bg-neutral-black-900 bg-cover bg-center overflow-hidden flex items-center justify-center" style={`background-image: linear-gradient(#081a3ecc, #081a3ecc), url('${image}')`}>
  <div class="relative z-10 px-[1.5rem] laptop:px-[1.875rem] mobile:px-[1rem] mx-auto w-full max-w-container text-center text-neutral-white">
    <h1 class="text-4xl tablet:text-5xl laptop:text-6xl font-serif font-bold text-neutral-white mb-4 reveal-up">
      {title}
    </h1>
    {description && (
      <p class="text-lg text-neutral-white-200 max-w-2xl mx-auto reveal-fade">
        {description}
      </p>
    )}
  </div>
</header>
